Price: <input type="number" id="productPrice" value="35000" size="10"> KRW
Stock: <input type="number" id="productStock" value="10" size="5">

<button onclick="addProduct()">Add Product</button>
</pre>

<h3>Product List</h3>
<pre id="productList">
Products
========

ID    Name                Price      Stock
----  ------------------  ---------  -----
001   Salt Bread          3,000      50
002   Croissant           4,000      30
003   Baguette            5,000      20
</pre>

<h3>Order Simulation</h3>
<pre>
Incoming Order
==============

<button onclick="simulateOrder()">Simulate Order</button>
</pre>

<pre id="orderResult"></pre>

<script>
var products = [
    {id: '001', name: 'Salt Bread', price: 3000, stock: 50},
    {id: '002', name: 'Croissant', price: 4000, stock: 30},
    {id: '003', name: 'Baguette', price: 5000, stock: 20}
];
var nextId = 4;

function renderProducts() {
    var result = 'Products\n========\n\nID    Name                Price      Stock\n----  ------------------  ---------  -----\n';
    for (var i = 0; i < products.length; i++) {
        var p = products[i];
        result += p.id.padEnd(6) + p.name.padEnd(20) + p.price.toLocaleString().padStart(9) + p.stock.toString().padStart(7) + '\n';
    }
    document.getElementById('productList').textContent = result;
}

function addProduct() {
    var name = document.getElementById('productName').value;
    var price = parseInt(document.getElementById('productPrice').value);
    var stock = parseInt(document.getElementById('productStock').value);

    products.push({
        id: nextId.toString().padStart(3, '0'),
        name: name,
        price: price,
        stock: stock
    });
    nextId++;

    renderProducts();
}

function simulateOrder() {
    var items = [];
    var total = 0;
    var numItems = Math.floor(Math.random() * 3) + 1;

    for (var i = 0; i < numItems; i++) {
        var p = products[Math.floor(Math.random() * products.length)];
        var qty = Math.floor(Math.random() * 3) + 1;
        items.push({product: p, quantity: qty});
        total += p.price * qty;
    }

    var payment = ['Kakao Pay', 'Naver Pay', 'Bank Transfer'][Math.floor(Math.random() * 3)];

    var result =
'New Order Received!\n' +
'===================\n\n' +
'Order ID: ORD-' + Date.now() + '\n' +
'Time: ' + new Date().toLocaleString() + '\n\n' +
'Items:\n';

    for (var j = 0; j < items.length; j++) {
        var item = items[j];
        result += '  ' + item.product.name + ' x ' + item.quantity + ' = ' + (item.product.price * item.quantity).toLocaleString() + ' KRW\n';
    }

    result += '\nTotal: ' + total.toLocaleString() + ' KRW\n';
    result += 'Payment: ' + payment + '\n\n';
    result += 'Customer: Kim ' + ['Minsu', 'Jiwon', 'Yuna', 'Donghyun'][Math.floor(Math.random() * 4)] + '\n';
    result += 'Phone: 010-' + Math.floor(Math.random() * 9000 + 1000) + '-' + Math.floor(Math.random() * 9000 + 1000) + '\n';
    result += 'Status: [OK] Payment Confirmed';

    document.getElementById('orderResult').textContent = result;
}
</script>

