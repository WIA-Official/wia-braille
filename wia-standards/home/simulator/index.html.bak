<h2 id="server">2. Personal Server Demo</h2>

<h3>Server Control Panel</h3>
<pre>
+------------------------------------------+
|  [MY-BAKERY] Server Control              |
+------------------------------------------+
|                                          |
|  Status: <span id="serverStatus">Stopped</span>                       |
|  Domain: <span id="serverDomain">happy-bakery.wia.shop</span>          |
|                                          |
|  [<button onclick="startServer()">Start Server</button>] [<button onclick="stopServer()">Stop Server</button>]     |
|                                          |
+------------------------------------------+
</pre>

<h3>Resource Monitor</h3>
<pre id="resourceMonitor">
Resources (when running):
  CPU:        0%
  Memory:     0 MB
  Bandwidth:  0 KB/s
  Visitors:   0 active
</pre>

<h3>Server Log</h3>
<pre id="serverLog" style="height:150px; overflow-y:scroll; border:1px solid #ccc; padding:5px;">
[System] Ready to start...
</pre>

<script>
var serverRunning = false;
var visitors = 0;
var logLines = ['[System] Ready to start...'];

function addLog(msg) {
    var time = new Date().toLocaleTimeString();
    logLines.push('[' + time + '] ' + msg);
    if (logLines.length > 20) logLines.shift();
    document.getElementById('serverLog').textContent = logLines.join('\n');
}

function startServer() {
    if (serverRunning) return;
    serverRunning = true;
    document.getElementById('serverStatus').textContent = 'Starting...';
    addLog('Starting WIA-HOME server...');

    setTimeout(function() {
        document.getElementById('serverStatus').textContent = 'Running';
        addLog('P2P network joined');
        addLog('Domain registered: happy-bakery.wia.shop');
        addLog('TLS-LITE enabled');
        addLog('Server running on port 8080');
        addLog('Ready to accept visitors!');
        updateResources();
    }, 1500);
}

function stopServer() {
    if (!serverRunning) return;
    serverRunning = false;
    document.getElementById('serverStatus').textContent = 'Stopping...';
    addLog('Gracefully shutting down...');

    setTimeout(function() {
        document.getElementById('serverStatus').textContent = 'Stopped';
        addLog('Server stopped');
        visitors = 0;
    }, 1000);
}

function updateResources() {
    if (!serverRunning) return;

    var cpu = Math.floor(Math.random() * 15) + 5;
    var memory = Math.floor(Math.random() * 50) + 100;
    var bandwidth = Math.floor(Math.random() * 200) + 50;

    if (Math.random() > 0.7) {
        visitors = Math.min(visitors + 1, 10);
        addLog('Visitor connected from ' + randomIP());
    }
    if (Math.random() > 0.8 && visitors > 0) {
        visitors--;
        addLog('Visitor disconnected');
    }

    document.getElementById('resourceMonitor').textContent =
        'Resources:\n' +
        '  CPU:        ' + cpu + '%\n' +
        '  Memory:     ' + memory + ' MB\n' +
        '  Bandwidth:  ' + bandwidth + ' KB/s\n' +
        '  Visitors:   ' + visitors + ' active';

    setTimeout(updateResources, 2000);
}

function randomIP() {
    return Math.floor(Math.random()*256) + '.' +
           Math.floor(Math.random()*256) + '.' +
           Math.floor(Math.random()*256) + '.' +
           Math.floor(Math.random()*256);
}
</script>

