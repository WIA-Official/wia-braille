<h2 id="p2p">3. P2P Network</h2>

<h3>Network Visualization</h3>
<pre>
P2P Mesh Network
================

      [Peer A]--------[Peer B]
        /  \            /  \
       /    \          /    \
      /      \        /      \
 [Peer C]----[YOUR PC]----[Peer D]
      \      /        \      /
       \    /          \    /
        \  /            \  /
      [Peer E]--------[Peer F]
              \      /
               \    /
             [Relay Node]
             (For NAT traversal)
</pre>

<h3>NAT Traversal Demo</h3>
<pre>
NAT Type Detection
==================

Your NAT Type: <span id="natType">Detecting...</span>

Types:
  [OK] Open        - Direct connection possible
  [OK] Full Cone   - Port forwarding works
  [i]  Restricted  - May need relay
  [!]  Symmetric   - Relay required

<button onclick="detectNAT()">Detect NAT Type</button>
</pre>

<pre id="natResult"></pre>

<script>
function detectNAT() {
    document.getElementById('natType').textContent = 'Detecting...';

    setTimeout(function() {
        var types = ['Open', 'Full Cone', 'Restricted', 'Symmetric'];
        var probs = [0.1, 0.3, 0.4, 0.2];
        var rand = Math.random();
        var cumulative = 0;
        var selected = 'Unknown';

        for (var i = 0; i < types.length; i++) {
            cumulative += probs[i];
            if (rand < cumulative) {
                selected = types[i];
                break;
            }
        }

        document.getElementById('natType').textContent = selected;

        var result = 'NAT Detection Result\n' +
                     '====================\n\n' +
                     'Type: ' + selected + '\n\n';

        if (selected === 'Open' || selected === 'Full Cone') {
            result += 'Status: [OK] Direct connections possible\n';
            result += 'Relay: Not required\n';
            result += 'Performance: Optimal';
        } else if (selected === 'Restricted') {
            result += 'Status: [i] May need relay for some peers\n';
            result += 'Relay: Occasionally used\n';
            result += 'Performance: Good';
        } else {
            result += 'Status: [!] Relay required for connections\n';
            result += 'Relay: Always used\n';
            result += 'Performance: Acceptable';
        }

        document.getElementById('natResult').textContent = result;
    }, 2000);
}
</script>

