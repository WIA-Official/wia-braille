<h2 id="api">8. API Reference</h2>

<h3>Core API</h3>
<pre>
WIA-HOME API
============

import { WIAHome } from '@anthropic/wia-home';

// Create home
const home = new WIAHome({
  name: 'My Shop',
  domain: 'myshop.wia.shop'
});

// Start server
await home.start();

// Check status
console.log(home.status);      // 'running'
console.log(home.domain);      // 'myshop.wia.shop'
console.log(home.stats.visitors.today);
</pre>

<h3>Quick Start API</h3>
<pre>
// 5-minute site creation
const mySite = await WIAHome.quickStart({
  benchmark: 'https://competitor.com',
  myInfo: {
    name: 'Happy Bakery',
    phone: '010-1234-5678',
    address: 'Seoul Gangnam',
    hours: '09:00-21:00'
  }
});

await mySite.start();
// Live at: happy-bakery.wia.shop
</pre>

<h3>Clone API</h3>
<pre>
// Analyze competitor
const analysis = await WIAHome.analyze('https://example.com');

// Clone with customization
const mySite = await WIAHome.clone('https://example.com', {
  customize: {
    name: 'My Shop',
    colors: { primary: '#3498db' }
  },
  features: {
    shop: true,
    booking: true
  }
});
</pre>

<h3>Intent API (Father Integration)</h3>
<pre>
// Natural language site creation
const mySite = await WIAHome.fromIntent(`
  I run a local bakery.
  Show bread types and prices.
  Enable reservations.
  Connect Instagram.
`);

// Father (INTENT) designs the house!
await mySite.start();
</pre>

<h3>Shop API</h3>
<pre>
// Add product
await home.shop.addProduct({
  name: 'Chocolate Cake',
  price: 35000,
  description: 'Fresh ingredients...',
  images: [cakeImage],
  inventory: 10
});

// Set payment
home.shop.setPayment({
  kakaoPay: true,
  naverPay: true,
  bankTransfer: { enabled: true }
});
</pre>

<h3>Booking API</h3>
<pre>
// Setup booking system
home.booking.setup({
  availability: {
    days: ['mon', 'tue', 'wed', 'thu', 'fri', 'sat'],
    hours: { start: '10:00', end: '20:00' },
    slotDuration: 60
  },
  services: [
    { name: 'Haircut', duration: 30, price: 15000 },
    { name: 'Perm', duration: 120, price: 80000 }
  ],
  notifications: {
    newBooking: ['kakao', 'sms']
  }
});
</pre>

<h3>Events API</h3>
<pre>
home.on('server_started', (e) => {
  console.log('Home open!');
});

home.on('visitor_connected', (e) => {
  console.log('Guest arrived!');
});

home.on('order_received', (e) => {
