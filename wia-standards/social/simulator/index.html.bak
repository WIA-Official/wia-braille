<h2 id="api">9. API Reference</h2>

<h3>Core API</h3>
<pre>
import { WIASocial } from '@anthropic/wia-social';

// Initialize
const social = new WIASocial({
  identity: myIdentity,
  platforms: ['instagram', 'twitter', 'tiktok'],
  privacy: { level: 'protected' }
});

// Connect
await social.connect();

// Get unified feed
const feed = await social.getFeed({
  limit: 50,
  sorting: 'chronological'
});

// Cross-post
await social.post({
  content: {
    text: 'Hello World!',
    media: [myPhoto]
  },
  targets: ['instagram', 'twitter']
});

// Find friend across platforms
const friend = await social.findFriendAcrossPlatforms('Hong Gildong');
</pre>

<h3>Feed API</h3>
<pre>
// Unified feed
const feed = await social.feed.getUnified({
  sorting: 'chronological',
  filters: {
    platforms: ['instagram', 'twitter'],
    hideReposts: true
  }
});

// Real-time subscription
social.feed.subscribe((post) => {
  console.log('New post:', post);
});
</pre>

<h3>Social Graph API</h3>
<pre>
// Follow/unfollow
await social.follow(friendIdentity);
await social.unfollow(friendIdentity);

// Get relationships
const followers = await social.getFollowers();
const following = await social.getFollowing();
const mutuals = await social.getMutuals();

// Cross-platform friend finder
const profiles = await social.findAcrossPlatforms(friend);
</pre>

<h3>Privacy API (Aunt Integration)</h3>
<pre>
// Pre-post scan
const scan = await social.privacy.scan(content);
if (!scan.safe) {
  console.log('Risks:', scan.risks);
}

// Strip metadata
const safeMedia = await social.privacy.stripMetadata(photo);

// Fuzzy location
const fuzzyLoc = social.privacy.fuzzyLocation(location, '5km');

// Anonymous posting
await social.postAnonymously({
  content: { text: 'Anonymous thought...' }
});
</pre>

<h3>Data Portability API</h3>
<pre>
// Export all
const backup = await social.exportAll();

// Export single platform
const twitterData = await social.exportPlatform('twitter');

// Import to new platform
await social.importTo('bluesky', twitterData);

// Delete data (GDPR)
await social.deleteFrom('facebook');
</pre>

<h3>Events</h3>
<pre>
social.on('new_post', (event) => {
  console.log('New post:', event.data);
});

social.on('new_follower', (event) => {
  console.log('New follower:', event.data);
});

social.on('privacy_alert', (event) => {
  console.log("Aunt's warning:", event.data);
});

social.on('platform_connected', (event) => {
  console.log('Platform connected:', event.data);
});
</pre>

