<script>
// Identity Demo
function createIdentity() {
  const name = document.getElementById('displayName').value;
  const email = document.getElementById('email').value;
  const wiaId = 'wia:' + name.toLowerCase().replace(/\s+/g, '.') + '.' + Math.floor(Math.random() * 10000);

  document.getElementById('identityResult').innerHTML = `
<pre>
[OK] Universal Identity Created

WIA ID: ${wiaId}
Display Name: ${name}
Email: ${email}
Status: Verified

Your identity is now portable across all platforms!
</pre>`;
}

function connectPlatforms() {
  const platforms = [];
  if (document.getElementById('connect_instagram').checked) platforms.push('Instagram (@hong_gildong)');
  if (document.getElementById('connect_twitter').checked) platforms.push('Twitter (@honggildong)');
  if (document.getElementById('connect_tiktok').checked) platforms.push('TikTok (@gildong_hong)');
  if (document.getElementById('connect_bluesky').checked) platforms.push('Bluesky (@hong.bsky.social)');
  if (document.getElementById('connect_mastodon').checked) platforms.push('Mastodon (@hong@mastodon.social)');

  let result = '<pre>\n[OK] Platforms Connected\n\n';
  platforms.forEach((p, i) => {
    result += `${i + 1}. ${p} - Connected\n`;
  });
  result += `\nTotal: ${platforms.length} platforms linked to your identity\n</pre>`;

  document.getElementById('connectResult').innerHTML = result;
}

// Cross-Post Demo
function crossPost() {
  const content = document.getElementById('postContent').value;
  const platforms = [];
  if (document.getElementById('post_instagram').checked) platforms.push('Instagram');
  if (document.getElementById('post_twitter').checked) platforms.push('Twitter');
  if (document.getElementById('post_threads').checked) platforms.push('Threads');
  if (document.getElementById('post_bluesky').checked) platforms.push('Bluesky');

  let result = '<pre>\n[OK] Cross-Post Successful\n\n';
  result += `Content: "${content}"\n\n`;
  result += 'Posted to:\n';
  platforms.forEach(p => {
    result += `  [OK] ${p} - Posted successfully\n`;
  });
  result += `\nTotal: ${platforms.length} platforms\n</pre>`;

  document.getElementById('postResult').innerHTML = result;
}

function previewOptimization() {
  const content = document.getElementById('postContent').value;

  document.getElementById('optimizationPreview').innerHTML = `
<pre>
Platform Optimization Preview
=============================

Original: "${content}"

Instagram:
  - Added relevant hashtags
  - Photo filters suggested
  - Stories format available

Twitter:
  - Character count: ${content.length}/280 [OK]
  - Thread option available if longer

Threads:
  - Cross-post to Instagram: Available
  - Plain text format

Bluesky:
  - Character count: ${content.length}/300 [OK]
  - Alt text for images suggested
</pre>`;
}

// Feed Demo
function toggleAllFeeds(checked) {
  document.getElementById('feed_instagram').checked = checked;
  document.getElementById('feed_twitter').checked = checked;
  document.getElementById('feed_tiktok').checked = checked;
  document.getElementById('feed_bluesky').checked = checked;
}

function loadFeed() {
  const sorting = document.getElementById('feedSorting').value;

  const posts = [
    { platform: 'Instagram', user: '@friend1', content: 'Beautiful sunset!', time: '2 min ago' },
    { platform: 'Twitter', user: '@friend2', content: 'Just shipped a new feature!', time: '5 min ago' },
    { platform: 'Bluesky', user: '@friend3.bsky', content: 'Loving the decentralized web', time: '10 min ago' },
    { platform: 'TikTok', user: '@friend4', content: '[Video] Dance challenge', time: '15 min ago' },
    { platform: 'Twitter', user: '@friend5', content: 'Hot take: tabs > spaces', time: '20 min ago' },
    { platform: 'Instagram', user: '@friend6', content: 'Coffee time', time: '25 min ago' }
  ];

  let result = `<pre>\nUnified Feed (${sorting})\n${'='.repeat(40)}\n\n`;

  posts.forEach((post, i) => {
    result += `[${post.platform}] ${post.user}\n`;
    result += `${post.content}\n`;
    result += `${post.time}\n\n`;
  });

  result += '</pre>';
  document.getElementById('feedResult').innerHTML = result;
}

// Social Graph Demo
function findFriend() {
  const query = document.getElementById('friendSearch').value;

  document.getElementById('friendResult').innerHTML = `
<pre>
Cross-Platform Search: "${query}"
================================

Found on 4 platforms:

1. Instagram: @kim_minsu
   - 1.2K followers
   - Mutual friends: 15

2. Twitter: @minsukim
   - 800 followers
   - Mutual friends: 8

3. Bluesky: @minsu.bsky.social
   - 200 followers
   - Mutual friends: 3

4. LinkedIn: Kim Minsu
   - 500+ connections
   - Mutual: 5

[i] Same person verified via email match
</pre>`;
}

function showNetwork() {
  document.getElementById('networkResult').innerHTML = `
<pre>
My Unified Social Network
=========================

Total Unique Connections: 847

By Platform:
  Instagram: 450 followers, 320 following
  Twitter: 380 followers, 250 following
  TikTok: 120 followers, 80 following
  Bluesky: 95 followers, 150 following

Cross-Platform Stats:
  - Friends on 2+ platforms: 156
  - Friends on 3+ platforms: 42
  - Friends on all platforms: 8

Top Mutual Friends:
  1. Kim Minsu (4 platforms)
  2. Lee Jiyoung (3 platforms)
  3. Park Jihoon (3 platforms)
</pre>`;
}

function followEverywhere() {
  document.getElementById('followResult').innerHTML = `
<pre>
Follow Everywhere: Kim Minsu
============================

[OK] Instagram @kim_minsu - Now following
[OK] Twitter @minsukim - Now following
[OK] Bluesky @minsu.bsky.social - Now following
[OK] LinkedIn Kim Minsu - Connection request sent

Total: Following on 4 platforms
</pre>`;
}

// Privacy Demo
function scanPrivacy() {
  const content = document.getElementById('privacyContent').value;

  let risks = [];
  if (content.match(/\d{3}[-.\s]?\d{4}/)) {
    risks.push({ type: 'Phone Number', severity: 'HIGH', detail: 'Phone number detected: 555-1234' });
  }
  if (content.match(/\d+\s+\w+\s+(street|st|avenue|ave|road|rd)/i)) {
    risks.push({ type: 'Address', severity: 'HIGH', detail: 'Physical address detected' });
  }
  if (content.match(/my|house|home/i)) {
    risks.push({ type: 'Location Hint', severity: 'MEDIUM', detail: 'Reference to personal location' });
  }

  let result = '<pre>\nAIR-SHIELD Privacy Scan Results\n================================\n\n';

  if (risks.length > 0) {
    result += '[!] Privacy Risks Detected\n\n';
    risks.forEach((r, i) => {
      result += `${i + 1}. ${r.type}\n`;
      result += `   Severity: ${r.severity}\n`;
      result += `   Detail: ${r.detail}\n\n`;
    });
    result += 'Recommendation: Review and edit before posting\n';
  } else {
    result += '[OK] No privacy risks detected\n';
    result += 'Safe to post!\n';
  }

  result += '</pre>';
  document.getElementById('privacyResult').innerHTML = result;
}

function savePrivacy() {
  const visibility = document.getElementById('defaultVisibility').value;
  const mode = document.getElementById('airshieldMode').value;

  document.getElementById('privacySaveResult').innerHTML = `
<pre>
[OK] Privacy Settings Saved

Default Visibility: ${visibility}
AIR-SHIELD Mode: ${mode}

Active Protections:
  [${document.getElementById('stripMetadata').checked ? 'OK' : '--'}] Strip photo metadata
  [${document.getElementById('fuzzyLocation').checked ? 'OK' : '--'}] Fuzzy location
  [${document.getElementById('hideReadReceipts').checked ? 'OK' : '--'}] Hide read receipts

Aunt (AIR-SHIELD) is now protecting your posts!
</pre>`;
}

// Messaging Demo
function loadConversations() {
  document.getElementById('conversationsResult').innerHTML = `
<pre>
Unified Inbox
=============

1. Kim Minsu
   Last: "See you tomorrow!" (Twitter)
   Time: 10 min ago
   Platforms: Instagram, Twitter, Telegram

2. Lee Jiyoung
   Last: "Thanks for sharing!" (Instagram)
   Time: 1 hour ago
   Platforms: Instagram

3. Park Jihoon
   Last: [Photo] (Telegram)
   Time: 2 hours ago
   Platforms: Telegram, Twitter

4. Tech Team Group
   Last: "Meeting at 3pm" (Discord)
   Time: 3 hours ago
   Platforms: Discord, Slack

Total: 23 conversations across 5 platforms
</pre>`;
}

function sendMessage() {
  const to = document.getElementById('msgTo').value;
  const platform = document.getElementById('msgPlatform').value;
  const content = document.getElementById('msgContent').value;

  let via = platform;
  if (platform === 'auto') {
    via = 'Telegram (fastest available)';
  } else if (platform === 'encrypted') {
    via = 'WIA Encrypted Channel';
  }

  document.getElementById('msgResult').innerHTML = `
<pre>
[OK] Message Sent

To: ${to}
Via: ${via}
Content: "${content}"
Status: Delivered
Time: Just now
${platform === 'encrypted' ? '\n[OK] End-to-end encrypted' : ''}
</pre>`;
}

// Data Portability Demo
function exportData() {
  const exportAll = document.querySelector('input[name="exportType"]:checked').value === 'all';
  const platform = document.getElementById('exportPlatform').value;

  const includes = [];
  if (document.getElementById('export_posts').checked) includes.push('Posts');
  if (document.getElementById('export_followers').checked) includes.push('Followers');
  if (document.getElementById('export_following').checked) includes.push('Following');
  if (document.getElementById('export_messages').checked) includes.push('Messages');
  if (document.getElementById('export_media').checked) includes.push('Media');

  document.getElementById('exportResult').innerHTML = `
<pre>
[OK] Export Complete

Type: ${exportAll ? 'All Platforms' : platform}
Format: wia-social-v1.json

Included Data:
${includes.map(i => '  [OK] ' + i).join('\n')}

Summary:
  - Posts: 1,247
  - Followers: 847
  - Following: 620
  - Media files: 3.2 GB

Export file: wia-export-2025-01-15.zip
</pre>`;
}

function migratePlatform() {
  const from = document.getElementById('migrateFrom').value;
  const to = document.getElementById('migrateTo').value;

  document.getElementById('migrateResult').innerHTML = `
<pre>
Platform Migration: ${from} -> ${to}
=====================================

Step 1: Export from ${from}
  [OK] Posts: 523 exported
  [OK] Following: 250 exported
  [OK] Media: 1.2 GB exported

Step 2: Transform data
  [OK] Format converted to ${to} compatible
  [OK] Handles mapped where possible

Step 3: Import to ${to}
  [OK] Posts: 523 imported
