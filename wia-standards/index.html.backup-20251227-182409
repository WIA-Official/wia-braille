    // Network initialization
    function initNetwork() {
        const container = document.getElementById("network-container");
        if (!container) return;
        const svg = d3.select("#network-svg");
        const width = container.clientWidth;
        const height = container.clientHeight;
        svg.attr("viewBox", "0 0 " + width + " " + height);
        
        const defs = svg.append("defs");
        Object.entries(levelColors).forEach(function([level, color]) {
            const gradient = defs.append("linearGradient").attr("id", "gradient-" + level).attr("x1", "0%").attr("y1", "0%").attr("x2", "100%").attr("y2", "100%");
            gradient.append("stop").attr("offset", "0%").attr("stop-color", color);
            gradient.append("stop").attr("offset", "100%").attr("stop-color", d3.color(color).darker(0.5));
        });
        
        const filter = defs.append("filter").attr("id", "glow");
        filter.append("feGaussianBlur").attr("stdDeviation", "3").attr("result", "coloredBlur");
        const feMerge = filter.append("feMerge");
        feMerge.append("feMergeNode").attr("in", "coloredBlur");
        feMerge.append("feMergeNode").attr("in", "SourceGraphic");
        
        // 초기 위치 랜덤 설정
        networkDomains.forEach(function(d, i) {
            d.x = width / 2 + (Math.random() - 0.5) * width * 0.8;
            d.y = height / 2 + (Math.random() - 0.5) * height * 0.8;
        });
        
        const simulation = d3.forceSimulation(networkDomains)
            .force("link", d3.forceLink(networkLinks).id(function(d) { return d.id; }).distance(180).strength(0.3))
            .force("charge", d3.forceManyBody().strength(-800))
            .force("center", d3.forceCenter(width / 2, height / 2))
            .force("collision", d3.forceCollide().radius(90))
            .force("x", d3.forceX(width / 2).strength(0.05))
            .force("y", d3.forceY(height / 2).strength(0.05))
            .alphaDecay(0.01);
        
        window.networkSimulation = simulation;
        
        const link = svg.append("g").selectAll("line").data(networkLinks).enter().append("line")
            .attr("stroke", "rgba(0,255,255,0.15)").attr("stroke-width", 1);
        window.networkLinks = link;
        
        const node = svg.append("g").selectAll("g").data(networkDomains).enter().append("g")
            .attr("class", "node").style("cursor", "pointer")
            .call(d3.drag().on("start", dragstarted).on("drag", dragged).on("end", dragended));
        
        node.append("rect").attr("width", 140).attr("height", 70).attr("x", -70).attr("y", -35).attr("rx", 10)
            .attr("fill", function(d) { return "url(#gradient-" + d.level + ")"; })
            .attr("fill-opacity", function(d) { return d.live > 0 ? 0.9 : 0.4; })
            .attr("stroke", function(d) { return levelColors[d.level]; })
            .attr("stroke-width", function(d) { return d.live > 0 ? 2 : 1; })
            .attr("filter", function(d) { return d.live > 0 ? "url(#glow)" : "none"; });
        
        node.append("text").attr("y", -8).attr("text-anchor", "middle").attr("font-size", "22px").text(function(d) { return d.emoji; });
        node.append("text").attr("y", 12).attr("text-anchor", "middle").attr("fill", "#fff").attr("font-family", "Orbitron, monospace").attr("font-size", "11px").attr("font-weight", "bold").text(function(d) { return d.name; });
        node.append("text").attr("y", 28).attr("text-anchor", "middle").attr("fill", function(d) { return d.live > 0 ? "#00ff88" : "#888"; }).attr("font-size", "10px").text(function(d) { return d.live > 0 ? d.live + "/" + d.count + " LIVE" : d.count + " COMING"; });
        
        const tooltip = document.getElementById("networkTooltip");
        
        node.on("mouseover", function(event, d) {
            link.attr("stroke", function(l) { return l.source.id === d.id || l.target.id === d.id ? levelColors[d.level] : "rgba(0,255,255,0.1)"; })
                .attr("stroke-width", function(l) { return l.source.id === d.id || l.target.id === d.id ? 2 : 1; });
            tooltip.innerHTML = "<div class=\"tooltip-title\">" + d.emoji + " " + d.name + "</div><div class=\"tooltip-stats\"><div class=\"tooltip-stat\"><div class=\"tooltip-stat-value\" style=\"color: " + levelColors[d.level] + "\">" + d.count + "</div><div class=\"tooltip-stat-label\">Total</div></div><div class=\"tooltip-stat\"><div class=\"tooltip-stat-value\" style=\"color: #00ff88\">" + d.live + "</div><div class=\"tooltip-stat-label\">Live</div></div><div class=\"tooltip-stat\"><div class=\"tooltip-stat-value\" style=\"color: #ff9500\">" + (d.count - d.live) + "</div><div class=\"tooltip-stat-label\">Coming</div></div></div><div class=\"tooltip-standards\">" + d.standards.join(" · ") + "</div>";
            tooltip.style.left = (event.pageX + 15) + "px";
            tooltip.style.top = (event.pageY - 10) + "px";
