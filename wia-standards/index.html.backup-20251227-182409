        <div class="network-tooltip" id="networkTooltip"></div>

        </div>

        <!-- ========== STANDARDS TAB ========== -->
        <div id="standards" class="tab-content active">
            
            <div class="level-header level-humanity">═══ 🟢 人 HUMANITY ═══</div>
