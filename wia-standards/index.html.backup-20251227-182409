                const data = await res.json();
                
                function animateCount(el, target, suffix) {
                    if(!el) return;
                    suffix = suffix || "";
                    let current = 0;
                    const step = Math.ceil(target / 50);
                    const timer = setInterval(function() {
                        current += step;
                        if(current >= target) {
                            current = target;
                            clearInterval(timer);
                        }
                        el.textContent = current.toLocaleString() + suffix;
                    }, 20);
                }
                
                animateCount(document.getElementById("stat-standards"), data.standards);
                animateCount(document.getElementById("stat-substandards"), data.substandards, "+");
                animateCount(document.getElementById("stat-simulators"), data.simulators);
                animateCount(document.getElementById("stat-tools"), data.tools);
                animateCount(document.getElementById("stat-lines"), data.lines.total);
                
            } catch(e) {
                console.error("Stats load error:", e);
            }
        }
        loadStats();
        // Search functionality
        const searchInput = document.getElementById("standardSearch");
        const searchResults = document.getElementById("searchResults");
        // searchCount removed
        const allCards = document.querySelectorAll("#standards .card");
        
        const standardsData = [];
        allCards.forEach(card => {
            const emoji = card.querySelector(".card-emoji")?.textContent || "";
            const title = card.querySelector(".card-title")?.textContent || "";
            const desc = card.querySelector(".card-desc")?.textContent || "";
            const id = card.querySelector(".card-id")?.textContent || "";
            const href = card.getAttribute("href") || "";
            if (title) standardsData.push({ emoji, title, desc, id, href });
        });
        
        // searchCount removed
        
        searchInput.addEventListener("input", function() {
            const query = this.value.toLowerCase().trim();
            if (query.length < 2) { searchResults.classList.remove("active"); return; }
            
            const filtered = standardsData.filter(s => 
                s.title.toLowerCase().includes(query) || 
                s.desc.toLowerCase().includes(query) || 
                s.id.toLowerCase().includes(query)
            ).slice(0, 10);
            
            if (filtered.length === 0) {
                searchResults.innerHTML = "<div class=\"search-result-item\"><div class=\"search-result-info\"><h4>No results found</h4><p>Try different keywords</p></div></div>";
            } else {
                searchResults.innerHTML = filtered.map(s => `<a href="${s.href}" class="search-result-item" target="_blank"><span class="search-result-emoji">${s.emoji}</span><div class="search-result-info"><h4>${s.title}</h4><p>${s.desc}</p></div></a>`).join("");
            }
            searchResults.classList.add("active");
        });
        
        document.addEventListener("click", function(e) {
            if (!e.target.closest(".search-container")) searchResults.classList.remove("active");
        });
