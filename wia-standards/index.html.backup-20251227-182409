        </div>
    </section>

    <div class="tabs-container">
        <div class="tabs">
            <button class="tab-btn active" onclick="showTab('standards', this)"><span class="emoji">📜</span> Standards</button>
            <button class="tab-btn" onclick="showTab('simulators', this)"><span class="emoji">🔬</span> 109+ Simulators</button>
            <button class="tab-btn" onclick="showTab('certification', this)"><span class="emoji">🏆</span> Certification</button>
            <button class="tab-btn" onclick="showTab('coin', this)"><span class="emoji">🪙</span> WIA Coin</button>
        </div>

        <!-- Search Box -->
        <div class="search-container">
            <input type="text" class="search-input" id="standardSearch" placeholder="Search 600+ standards... (e.g. emotion, pet, crypto)" data-i18n-placeholder="search.placeholder">
