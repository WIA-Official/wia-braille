<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WIA Family - World Certification Industry Association</title>
    <link rel="icon" type="image/x-icon" href="images/favi.png">
    <meta name="description" content="WIA - 弘益人間. 18 years of dedication to benefit all humanity. 109+ simulators, 25 categories, 177+ standards.">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0a0a0f; color: white; min-height: 100vh; }
        
        .emoji { background: none !important; -webkit-background-clip: initial !important; -webkit-text-fill-color: initial !important; }
        .gradient-text { background: linear-gradient(90deg, #00d4ff, #7b2cbf); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        .header { background: linear-gradient(135deg, #1a1a2e, #16213e); padding: 20px 40px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 1000; }
        .logo { display: flex; align-items: center; gap: 15px; text-decoration: none; color: white; }
        .logo img { height: 50px; }
        .logo-text { font-size: 1.5rem; font-weight: bold; }
        .nav-links { display: flex; gap: 30px; }
        .nav-links a { color: #a0a0a0; text-decoration: none; font-size: 0.95rem; }
        .nav-links a:hover { color: #00d4ff; }
        .lang-btn { display: flex; align-items: center; gap: 8px; padding: 8px 16px; border: 1px solid #30363d; background: transparent; color: #a0a0a0; border-radius: 8px; cursor: pointer; transition: all 0.3s; font-size: 0.9rem; }
        .lang-btn:hover { border-color: #00d4ff; color: #00d4ff; }
        .lang-btn .globe-icon { font-size: 1.1rem; }
        .lang-modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 2000; justify-content: center; align-items: center; }
        .lang-modal-overlay.show { display: flex; }
        .lang-modal-content { background: #1a1a2e; border-radius: 16px; padding: 30px; max-width: 600px; max-height: 80vh; overflow-y: auto; border: 1px solid #30363d; }
        .lang-modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .lang-modal-title { font-size: 1.3rem; color: #00d4ff; }
        .lang-modal-close { background: none; border: none; color: #888; font-size: 1.5rem; cursor: pointer; }
        .lang-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
        .lang-option { padding: 12px 16px; background: rgba(255,255,255,0.05); border: 1px solid #30363d; border-radius: 8px; cursor: pointer; transition: all 0.3s; text-align: left; }
        .lang-option:hover { border-color: #00d4ff; background: rgba(0,212,255,0.1); }
        .lang-option.active { border-color: #00d4ff; background: rgba(0,212,255,0.2); }
        .lang-flag { font-size: 1.2rem; margin-right: 8px; }
        .lang-name { color: white; font-size: 0.9rem; }
        
        .hero { text-align: center; padding: 100px 20px; background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 50%, #1a1a2e 100%); position: relative; overflow: hidden; }
        .hero::before { content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(circle at 50% 50%, rgba(0,212,255,0.1) 0%, transparent 50%); }
        .hero h1 { font-size: 4rem; margin-bottom: 20px; position: relative; }
        .hero p { font-size: 1.3rem; color: #a0a0a0; margin-bottom: 10px; position: relative; }
        .hero-philosophy { font-size: 2rem; color: #ffd700; margin: 30px 0; font-style: italic; position: relative; }
        .hero-subtitle { font-size: 1.1rem; color: #666; max-width: 800px; margin: 0 auto 40px; line-height: 1.8; position: relative; }
        .hero-stats { display: flex; justify-content: center; gap: 80px; margin-top: 50px; flex-wrap: wrap; position: relative; }
        .hero-stat { text-align: center; }
        .hero-stat-num { font-size: 3.5rem; font-weight: bold; background: linear-gradient(135deg, #00d4ff, #7b2cbf); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .hero-stat-label { color: #888; font-size: 1rem; margin-top: 5px; }
        
        .tabs-container { max-width: 1400px; margin: 0 auto; padding: 40px 20px; }
        .tabs { display: flex; justify-content: center; gap: 10px; margin-bottom: 40px; flex-wrap: wrap; }
        .tab-btn { padding: 15px 40px; border: 2px solid #30363d; background: transparent; color: #a0a0a0; font-size: 1.1rem; cursor: pointer; border-radius: 8px; transition: all 0.3s; }
        .tab-btn:hover { border-color: #00d4ff; color: #00d4ff; }
        .tab-btn.active { background: linear-gradient(135deg, #00d4ff, #7b2cbf); border-color: transparent; color: white; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        
        .section-title { text-align: center; font-size: 1.8rem; color: #00d4ff; margin: 50px 0 15px; }
        .section-subtitle { text-align: center; color: #666; margin-bottom: 30px; font-size: 0.95rem; }
        
        .cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 320px)); gap: 20px; margin-bottom: 40px; justify-content: center; max-width: 1000px; margin-left: auto; margin-right: auto; }
        @media (max-width: 700px) { .cards-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 600px) { .cards-grid { grid-template-columns: 1fr; } }
        .card { background: linear-gradient(135deg, #1a1a2e, #16213e); border-radius: 16px; padding: 25px; text-decoration: none; color: white; transition: all 0.3s; border: 1px solid transparent; }
        .card:hover { transform: translateY(-5px); box-shadow: 0 15px 50px rgba(0,212,255,0.25); border-color: rgba(0,212,255,0.3); }
        .card-id { font-size: 11px; color: #64748b; font-family: "Monaco", "Consolas", monospace; letter-spacing: 0.5px; margin-bottom: 8px; text-align: center; }
        .card-emoji { font-size: 45px; margin-bottom: 15px; }
        .card-title { font-size: 1.3rem; margin-bottom: 8px; font-weight: 600; }
        .card-desc { color: #a0a0a0; font-size: 0.85rem; line-height: 1.6; }
        .card-badge { display: inline-block; padding: 4px 12px; border-radius: 12px; font-size: 0.75rem; margin-top: 12px; }
        .card-badge.done { background: linear-gradient(135deg, #10b981, #059669); }
        .card-badge.coming { background: linear-gradient(135deg, #f59e0b, #d97706); }
        .card-badge.live { background: linear-gradient(135deg, #8b5cf6, #7c3aed); }
        
        .sim-section { background: linear-gradient(135deg, #1a1a2e, #16213e); border-radius: 16px; padding: 40px; margin-bottom: 30px; }
        .sim-title { font-size: 1.4rem; color: #00d4ff; margin-bottom: 10px; }
        .sim-subtitle { color: #666; font-size: 0.9rem; margin-bottom: 20px; }
        .sim-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
        .sim-item { background: rgba(255,255,255,0.05); padding: 15px; border-radius: 10px; text-decoration: none; color: white; transition: all 0.3s; border: 1px solid rgba(255,255,255,0.1); }
        .sim-item:hover { background: rgba(0,212,255,0.15); border-color: rgba(0,212,255,0.4); transform: translateY(-2px); }
        .sim-item-title { font-size: 0.95rem; font-weight: 500; margin-bottom: 5px; }
        .sim-item-desc { font-size: 0.8rem; color: #888; line-height: 1.4; }
        
        .cert-section { background: linear-gradient(135deg, #1a1a2e, #16213e); border-radius: 16px; padding: 40px; margin-bottom: 30px; }
        .cert-title { font-size: 1.4rem; color: #00d4ff; margin-bottom: 20px; }
        .cert-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
        .cert-item { background: rgba(255,255,255,0.08); padding: 10px 14px; border-radius: 8px; font-size: 0.8rem; text-decoration: none; color: white; text-align: center; transition: all 0.3s; }
        .cert-item:hover { background: rgba(0,212,255,0.2); transform: translateY(-2px); }
        .cert-item.done { border: 1px solid #10b981; }
        .cert-item.coming { border: 1px solid #f59e0b; opacity: 0.85; }
        
        .coin-hero { text-align: center; padding: 60px; background: linear-gradient(135deg, #1a1a2e, #16213e); border-radius: 16px; margin-bottom: 30px; }
        .coin-logo { font-size: 80px; margin-bottom: 20px; }
        .coin-name { font-size: 2.5rem; color: #00d4ff; margin-bottom: 10px; }
        .coin-desc { color: #a0a0a0; font-size: 1.1rem; max-width: 600px; margin: 0 auto 30px; line-height: 1.7; }
        .coin-links { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; }
        .coin-link { padding: 12px 30px; border: 2px solid #00d4ff; border-radius: 8px; color: #00d4ff; text-decoration: none; transition: all 0.3s; }
        .coin-link:hover { background: #00d4ff; color: #0a0a0f; }
        
        /* 컴팩트 푸터 */
        .footer { background: linear-gradient(135deg, #0d0d14, #1a1a2e); padding: 50px 40px 30px; margin-top: 60px; border-top: 1px solid #30363d; }
        .footer-inner { max-width: 1200px; margin: 0 auto; }
        .footer-top { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 40px; margin-bottom: 40px; }
        .footer-section { min-width: 200px; }
        .footer-section h4 { color: #00d4ff; font-size: 1rem; margin-bottom: 15px; }
        .footer-section p { color: #888; font-size: 0.85rem; line-height: 1.7; }
        .footer-section a { color: #888; text-decoration: none; display: block; margin-bottom: 8px; font-size: 0.85rem; }
        .footer-section a:hover { color: #00d4ff; }
        .footer-philosophy { color: #ffd700; font-size: 1.1rem; margin-bottom: 5px; }
        .footer-bottom { border-top: 1px solid #30363d; padding-top: 25px; text-align: center; }
        .footer-copyright { color: #555; font-size: 0.8rem; line-height: 1.8; }
        .footer-stats { color: #444; font-size: 0.75rem; margin-top: 10px; }
        /* Level Headers */
        .level-header { max-width: 1000px;
            text-align: center;
            font-size: 2.2rem;
            font-weight: 900;
            margin: 60px auto 40px;
            padding: 20px;
            border-top: 3px solid;
            border-bottom: 3px solid;
            letter-spacing: 0.2em;
        }
        .level-humanity {
            color: #10b981;
            border-color: #10b981;
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(5, 150, 105, 0.05));
        }
        .level-technology {
            color: #3b82f6;
            border-color: #3b82f6;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(37, 99, 235, 0.05));
        }
        .level-world {
            color: #a855f7;
            border-color: #a855f7;
            background: linear-gradient(135deg, rgba(168, 85, 247, 0.1), rgba(147, 51, 234, 0.05));
        }
        /* Search Box */
        .search-container { max-width: 1000px; margin: 30px auto; position: relative; }
        .search-input { width: 100%; padding: 15px 50px 15px 20px; border: 2px solid #30363d; background: rgba(15, 23, 42, 0.8); color: #f8fafc; font-size: 1.1rem; border-radius: 12px; outline: none; transition: all 0.3s; }
        .search-input:focus { border-color: #00d4ff; box-shadow: 0 0 20px rgba(0, 212, 255, 0.2); }
        .search-input::placeholder { color: #64748b; }
        .search-icon { position: absolute; right: 18px; top: 50%; transform: translateY(-50%); color: #64748b; font-size: 1.2rem; }
        .search-results { position: absolute; top: 100%; left: 0; right: 0; background: #1e293b; border: 1px solid #30363d; border-radius: 12px; margin-top: 8px; max-height: 400px; overflow-y: auto; display: none; z-index: 1000; }
        .search-results.active { display: block; }
        .search-result-item { padding: 12px 20px; border-bottom: 1px solid #30363d; cursor: pointer; display: flex; align-items: center; gap: 12px; }
        .search-result-item:hover { background: #334155; }
        .search-result-item:last-child { border-bottom: none; }
        .search-result-emoji { font-size: 1.5rem; }
        .search-result-info h4 { color: #f8fafc; margin-bottom: 2px; }
        .search-result-info p { color: #64748b; font-size: 0.85rem; }
        .search-count { text-align: center; color: #64748b; font-size: 0.9rem; margin-top: 10px; }
        /* Network Visualization Styles */
        .network-section { position: relative; background: rgba(10,10,20,0.9); border: 1px solid rgba(0,255,255,0.3); border-radius: 15px; overflow: hidden; margin: 30px auto; max-width: 1400px; }
        .network-header { display: flex; justify-content: space-between; align-items: center; padding: 15px 25px; background: linear-gradient(90deg, rgba(0,255,255,0.1) 0%, rgba(255,0,255,0.1) 100%); border-bottom: 1px solid rgba(0,255,255,0.2); flex-wrap: wrap; gap: 10px; }
        .network-title { font-family: "Orbitron", monospace; font-size: 1.2rem; color: #00ffff; text-transform: uppercase; letter-spacing: 3px; }
        .network-stats { display: flex; gap: 20px; flex-wrap: wrap; }
        .network-stat { text-align: center; }
        .network-stat-value { font-family: "Orbitron", monospace; font-size: 1.3rem; font-weight: 900; }
        .network-stat-value.total { color: #00ffff; }
        .network-stat-value.live { color: #00ff88; }
        .network-stat-value.coming { color: #ff9500; }
        .network-stat-label { font-size: 0.7rem; color: #888; text-transform: uppercase; letter-spacing: 1px; }
        .network-controls { display: flex; gap: 10px; }
        .control-btn { padding: 8px 16px; background: transparent; border: 1px solid rgba(0,255,255,0.5); color: #00ffff; font-family: "Rajdhani", sans-serif; font-size: 0.85rem; border-radius: 5px; cursor: pointer; transition: all 0.3s; }
        .control-btn:hover { background: rgba(0,255,255,0.2); box-shadow: 0 0 15px rgba(0,255,255,0.3); }
        #network-container { width: 100%; height: 600px; position: relative; background: radial-gradient(ellipse at 50% 50%, rgba(0,255,255,0.05) 0%, transparent 70%); }
        #network-svg { width: 100%; height: 100%; }
        .network-legend { display: flex; justify-content: center; gap: 30px; padding: 15px; flex-wrap: wrap; border-top: 1px solid rgba(0,255,255,0.2); background: rgba(0,0,0,0.3); }
        .legend-item { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; }
        .legend-color { width: 16px; height: 16px; border-radius: 4px; }
        .network-tooltip { position: absolute; background: rgba(10,10,30,0.95); border: 1px solid #00ffff; border-radius: 8px; padding: 15px; pointer-events: none; opacity: 0; transition: opacity 0.2s; z-index: 100; max-width: 350px; box-shadow: 0 0 20px rgba(0,255,255,0.3); }
        .network-tooltip.visible { opacity: 1; }
        .tooltip-title { font-family: "Orbitron", monospace; font-size: 1rem; color: #00ffff; margin-bottom: 8px; }
        .tooltip-stats { display: flex; gap: 15px; margin-bottom: 8px; }
        .tooltip-stat { text-align: center; }
        .tooltip-stat-value { font-size: 1.2rem; font-weight: bold; }
        .tooltip-stat-label { font-size: 0.7rem; color: #888; }
        .tooltip-standards { font-size: 0.75rem; color: #aaa; max-height: 80px; overflow-y: auto; line-height: 1.4; }
        @media (max-width: 768px) { .network-header { flex-direction: column; text-align: center; } .network-stats { justify-content: center; } #network-container { height: 450px; } }
    </style>
</head>
<body>
    <header class="header">
        <a href="/" class="logo">
            <img src="images/img_logo_new.png" alt="WIA">
            <span class="logo-text"><span class="emoji">🤟</span> <span class="gradient-text" data-i18n="hero.title">WIA Family</span></span>
        </a>
        <nav class="nav-links">
            <a href="https://wiastandards.com" target="_blank">WIA Live</a>
            <a href="https://cert.wiastandards.com" target="_blank">Certification</a>
            <a href="https://sim.wiastandards.com" target="_blank">Simulator</a>
