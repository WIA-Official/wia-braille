<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WIA AUTO-SECURE | One-Click HTTPS Installation</title>
    <link rel="icon" href="/favicon.ico">
    <style>
        :root { --primary: #10B981; --primary-dark: #059669; --bg: #0f172a; --bg-card: #1e293b; --text: #f8fafc; --text-muted: #94a3b8; --border: #334155; --gold: #ffd700; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; line-height: 1.6; }
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
        
        /* 표준 헤더 */
        .top-nav { display: flex; justify-content: space-between; align-items: center; padding: 15px 0; border-bottom: 1px solid var(--border); margin-bottom: 40px; }
        .nav-left { display: flex; align-items: center; gap: 20px; }
        .nav-home { color: var(--text); text-decoration: none; font-weight: bold; font-size: 1.1rem; }
        .nav-home:hover { color: var(--primary); }
        .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--text-muted); }
        .breadcrumb a { color: var(--text-muted); text-decoration: none; }
        .breadcrumb a:hover { color: var(--primary); }
        .breadcrumb .sep { color: var(--border); }
        .breadcrumb .current { color: var(--primary); font-weight: 500; }
        .lang-switch { display: flex; gap: 5px; }
        .lang-btn { padding: 6px 12px; border: 1px solid var(--border); background: transparent; color: var(--text-muted); border-radius: 6px; cursor: pointer; font-size: 0.85rem; transition: all 0.2s; }
        .lang-btn:hover { border-color: var(--primary); }
        .lang-btn.active { background: var(--primary); color: white; border-color: var(--primary); }
        
        /* 히어로 */
        .hero { text-align: center; margin-bottom: 50px; padding: 40px 0; }
        .hero-emoji { font-size: 80px; margin-bottom: 20px; animation: pulse 2s ease-in-out infinite; }
        @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15); } }
        .hero h1 { font-size: 2.8rem; margin-bottom: 15px; background: linear-gradient(90deg, var(--primary), #34d399); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .hero .subtitle { color: var(--gold); font-size: 1.3rem; margin-bottom: 10px; }
        .hero .desc { color: var(--text-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }
        
        /* 원클릭 설치 섹션 */
        .install-section { background: var(--bg-card); border: 2px solid var(--primary); border-radius: 16px; padding: 40px; margin-bottom: 40px; text-align: center; }
        .install-section h2 { color: var(--primary); margin-bottom: 20px; font-size: 1.5rem; }
        .install-cmd { background: #0d1117; border: 1px solid var(--border); border-radius: 12px; padding: 20px 30px; font-family: 'Monaco', 'Menlo', monospace; font-size: 1rem; color: #58a6ff; margin: 20px 0; display: inline-block; max-width: 100%; overflow-x: auto; }
        .install-cmd::before { content: '$ '; color: var(--primary); }
        .copy-btn { background: var(--primary); color: white; border: none; padding: 12px 30px; border-radius: 8px; cursor: pointer; font-size: 1rem; margin-top: 15px; transition: all 0.2s; }
        .copy-btn:hover { background: var(--primary-dark); transform: translateY(-2px); }
        .copy-btn.copied { background: var(--gold); color: #0f172a; }
        
        /* 특징 카드 - 2x2 그리드 */
        .features { display: grid; grid-template-columns: repeat(2, 1fr); gap: 25px; margin-bottom: 50px; }
        .feature-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 30px; transition: all 0.3s; }
        .feature-card:hover { border-color: var(--primary); transform: translateY(-5px); }
        .feature-icon { font-size: 2.5rem; margin-bottom: 15px; }
        .feature-card h3 { color: var(--text); margin-bottom: 10px; font-size: 1.2rem; }
        .feature-card p { color: var(--text-muted); font-size: 0.95rem; }
        
        /* 지원 플랫폼 - 4x2 그리드 */
        .supported { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 40px; margin-bottom: 40px; }
        .supported h2 { text-align: center; margin-bottom: 30px; color: var(--text); }
        .os-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; }
        .os-item { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 15px 20px; display: flex; align-items: center; gap: 10px; justify-content: center; }
        .os-item span { font-size: 1.3rem; }
        .os-item:hover { border-color: var(--primary); }
        
        /* 다운로드 */
        .download-section { text-align: center; margin-bottom: 50px; }
        .download-btn { display: inline-flex; align-items: center; gap: 10px; background: linear-gradient(135deg, var(--primary), #34d399); color: white; text-decoration: none; padding: 18px 40px; border-radius: 12px; font-size: 1.2rem; font-weight: 600; transition: all 0.3s; }
        .download-btn:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(16, 185, 129, 0.3); }
        
        /* 사용법 */
        .usage { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 40px; margin-bottom: 40px; }
        .usage h2 { margin-bottom: 25px; }
        .step { display: flex; gap: 20px; margin-bottom: 25px; align-items: flex-start; }
        .step-num { background: var(--primary); color: white; width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; flex-shrink: 0; }
        .step-content h3 { margin-bottom: 8px; }
        .step-content p { color: var(--text-muted); }
        .step-content code { background: #0d1117; padding: 3px 8px; border-radius: 4px; font-family: monospace; color: #58a6ff; }
        
        /* 푸터 */
        footer { margin-top: 60px; padding: 30px 0; border-top: 1px solid var(--border); text-align: center; }
        footer .philosophy { color: var(--gold); font-size: 1.1rem; margin-bottom: 10px; }
        footer p { color: var(--text-muted); margin: 5px 0; font-size: 0.9rem; }
        footer .footer-links { margin-top: 15px; }
        footer .footer-links a { color: var(--text-muted); text-decoration: none; margin: 0 10px; font-size: 0.85rem; }
        footer .footer-links a:hover { color: var(--primary); }
        
        @media (max-width: 900px) {
            .os-grid { grid-template-columns: repeat(2, 1fr); }
        }
        @media (max-width: 768px) {
            .top-nav { flex-direction: column; gap: 15px; }
            .breadcrumb { display: none; }
            .hero h1 { font-size: 2rem; }
            .install-cmd { font-size: 0.85rem; padding: 15px; }
            .features { grid-template-columns: 1fr; }
            .os-grid { grid-template-columns: repeat(2, 1fr); }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- 표준 헤더 -->
        <nav class="top-nav">
            <div class="nav-left">
                <a href="https://wiastandards.com" class="nav-home">🤟 WIA Standards</a>
                <div class="breadcrumb">
                    <a href="https://wiastandards.com">Home</a>
                    <span class="sep">›</span>
                    <span class="current">AUTO-SECURE</span>
                </div>
            </div>
            <div class="lang-switch">
                <button class="lang-btn active" onclick="setLang('en')">EN</button>
                <button class="lang-btn" onclick="setLang('ko')">KO</button>
            </div>
        </nav>

        <!-- 히어로 -->
        <div class="hero">
            <div class="hero-emoji">🔐</div>
            <h1>WIA AUTO-SECURE</h1>
            <p class="subtitle">弘益人間 · Benefit All Humanity</p>
            <p class="desc" data-en="One-Click HTTPS Installation for Everyone. Free SSL certificates with automatic 90-day renewal." data-ko="누구나 원클릭으로 HTTPS 설치. 무료 SSL 인증서와 90일 자동 갱신.">One-Click HTTPS Installation for Everyone. Free SSL certificates with automatic 90-day renewal.</p>
        </div>

        <!-- 원클릭 설치 -->
        <div class="install-section">
            <h2 data-en="⚡ One-Line Installation" data-ko="⚡ 한 줄 설치">⚡ One-Line Installation</h2>
            <div class="install-cmd" id="install-cmd">curl -sSL https://wiastandards.com/auto-secure/linux/wia-secure-install.sh | bash</div>
            <br>
            <button class="copy-btn" onclick="copyCmd()" data-en="📋 Copy Command" data-ko="📋 명령어 복사">📋 Copy Command</button>
        </div>

        <!-- 특징 - 2x2 -->
        <div class="features">
            <div class="feature-card">
                <div class="feature-icon">🚀</div>
                <h3 data-en="Zero Configuration" data-ko="설정 불필요">Zero Configuration</h3>
                <p data-en="Automatically detects your OS, web server (Nginx/Apache), and configures everything." data-ko="OS, 웹서버(Nginx/Apache)를 자동 감지하고 모든 설정을 자동화합니다.">Automatically detects your OS, web server (Nginx/Apache), and configures everything.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🔄</div>
                <h3 data-en="Auto-Renewal" data-ko="자동 갱신">Auto-Renewal</h3>
                <p data-en="SSL certificates automatically renew every 60-90 days. Set it and forget it!" data-ko="SSL 인증서가 60~90일마다 자동 갱신됩니다. 설치 후 신경 쓸 필요 없어요!">SSL certificates automatically renew every 60-90 days. Set it and forget it!</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">💰</div>
                <h3 data-en="100% Free" data-ko="100% 무료">100% Free</h3>
                <p data-en="Uses Let's Encrypt free SSL certificates. No hidden costs, no subscriptions." data-ko="Let's Encrypt 무료 SSL 인증서 사용. 숨겨진 비용이나 구독 없음.">Uses Let's Encrypt free SSL certificates. No hidden costs, no subscriptions.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🛡️</div>
                <h3 data-en="Enterprise Grade" data-ko="엔터프라이즈급 보안">Enterprise Grade</h3>
                <p data-en="Same encryption used by banks and governments. A+ SSL rating guaranteed." data-ko="은행과 정부가 사용하는 동일한 암호화. A+ SSL 등급 보장.">Same encryption used by banks and governments. A+ SSL rating guaranteed.</p>
            </div>
        </div>

        <!-- 지원 플랫폼 - 4x2 -->
        <div class="supported">
            <h2 data-en="🖥️ Supported Platforms" data-ko="🖥️ 지원 플랫폼">🖥️ Supported Platforms</h2>
            <div class="os-grid">
                <div class="os-item"><span>🐧</span> Ubuntu / Debian</div>
                <div class="os-item"><span>🎩</span> CentOS / RHEL</div>
                <div class="os-item"><span>☁️</span> Amazon Linux</div>
                <div class="os-item"><span>🏔️</span> Arch Linux</div>
                <div class="os-item"><span>🦎</span> openSUSE</div>
                <div class="os-item"><span>🌐</span> Nginx</div>
                <div class="os-item"><span>🪶</span> Apache (httpd)</div>
                <div class="os-item"><span>📦</span> Standalone</div>
            </div>
        </div>

        <!-- 사용법 -->
        <div class="usage">

        <!-- 사전 요구사항 -->
        <div class="usage" style="border-color: #f59e0b; margin-bottom: 30px;">
            <h2 data-en="⚠️ Before You Start" data-ko="⚠️ 시작 전 확인">⚠️ Before You Start</h2>
            
            <div class="step">
                <div class="step-num" style="background: #f59e0b;">1</div>
                <div class="step-content">
                    <h3 data-en="Domain Required" data-ko="도메인 필요">Domain Required</h3>
                    <p data-en="You need a registered domain (e.g., example.com)" data-ko="등록된 도메인이 필요합니다 (예: example.com)">You need a registered domain (e.g., example.com)</p>
                </div>
            </div>
            
            <div class="step">
                <div class="step-num" style="background: #f59e0b;">2</div>
                <div class="step-content">
                    <h3 data-en="DNS Must Point to Server" data-ko="DNS가 서버를 가리켜야 함">DNS Must Point to Server</h3>
                    <p data-en="Your domain A record must point to your server IP address" data-ko="도메인 A 레코드가 서버 IP 주소를 가리켜야 합니다">Your domain's A record must point to your server IP address</p>
                    <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 5px;" data-en="Check: nslookup example.com → should show your server IP" data-ko="확인: nslookup example.com → 서버 IP가 나와야 함">Check: <code>nslookup example.com</code> → should show your server IP</p>
                </div>
            </div>
            
            <div class="step">
                <div class="step-num" style="background: #f59e0b;">3</div>
                <div class="step-content">
                    <h3 data-en="Port 80 Open" data-ko="80포트 열림">Port 80 Open</h3>
                    <p data-en="Server firewall must allow HTTP (port 80) for domain verification" data-ko="도메인 인증을 위해 서버 방화벽에서 HTTP(80포트)가 열려있어야 합니다">Server firewall must allow HTTP (port 80) for domain verification</p>
                </div>
            </div>
        </div>

            <h2 data-en="📖 How to Use" data-ko="📖 사용 방법">📖 How to Use</h2>
            
            <div class="step">
                <div class="step-num">1</div>
                <div class="step-content">
                    <h3 data-en="Run the script" data-ko="스크립트 실행">Run the script</h3>
                    <p data-en="Copy and paste the command above into your terminal" data-ko="위의 명령어를 터미널에 복사하여 붙여넣기"></p>
                </div>
            </div>
            
            <div class="step">
                <div class="step-num">2</div>
                <div class="step-content">
                    <h3 data-en="Enter your domain" data-ko="도메인 입력">Enter your domain</h3>
                    <p data-en="Example: " data-ko="예시: "><code>example.com</code></p>
                </div>
            </div>
            
            <div class="step">
                <div class="step-num">3</div>
                <div class="step-content">
                    <h3 data-en="Enter your email" data-ko="이메일 입력">Enter your email</h3>
                    <p data-en="For Let's Encrypt renewal notifications" data-ko="Let's Encrypt 갱신 알림용"></p>
                </div>
            </div>
            
            <div class="step">
                <div class="step-num">4</div>
                <div class="step-content">
                    <h3 data-en="Done! 🎉" data-ko="완료! 🎉">Done! 🎉</h3>
                    <p data-en="Your site is now HTTPS secured with auto-renewal!" data-ko="이제 사이트가 HTTPS로 보호되며 자동 갱신됩니다!"></p>
                </div>
            </div>
        </div>

        <!-- 다운로드 -->
        <div class="download-section">
            <a href="/auto-secure/linux/wia-secure-install.sh" class="download-btn" download>
                <span>⬇️</span>
                <span data-en="Download Script" data-ko="스크립트 다운로드">Download Script</span>
            </a>
            <p style="color: var(--text-muted); margin-top: 15px;" data-en="v1.0 • 15 KB • MIT License" data-ko="v1.0 • 15 KB • MIT 라이선스">v1.0 • 15 KB • MIT License</p>
        </div>
    </div>

    <!-- 푸터 -->
    <footer>
        <p class="philosophy">弘益人間 · 널리 인간을 이롭게 하라</p>
        <p>WIA - World Interoperability Alliance</p>
        <p>© 2025 MIT License</p>
        <div class="footer-links">
            <a href="https://wiastandards.com">🏠 Home</a>
            <a href="https://github.com/WIA-Official/wia-standards" target="_blank">GitHub</a>
            <a href="https://cert.wiastandards.com" target="_blank">Certification</a>
        </div>
    </footer>

    <script>
        function setLang(lang) {
            localStorage.setItem('wiaLang', lang);
            document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelector(`.lang-btn:${lang === 'en' ? 'first-child' : 'last-child'}`).classList.add('active');
            document.querySelectorAll('[data-en]').forEach(el => {
                el.textContent = el.getAttribute('data-' + lang);
            });
        }
        
        function copyCmd() {
            const cmd = document.getElementById('install-cmd').textContent;
            navigator.clipboard.writeText(cmd).then(() => {
                const btn = document.querySelector('.copy-btn');
                btn.classList.add('copied');
                btn.textContent = '✅ Copied!';
                setTimeout(() => {
                    btn.classList.remove('copied');
                    const lang = localStorage.getItem('wiaLang') || 'en';
                    btn.textContent = lang === 'en' ? '📋 Copy Command' : '📋 명령어 복사';
                }, 2000);
            });
        }
        
        // 초기화
        const savedLang = localStorage.getItem('wiaLang') || 'en';
        setLang(savedLang);
    </script>
</body>
</html>
