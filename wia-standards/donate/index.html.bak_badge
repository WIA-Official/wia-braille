    <script>
        // Force update all texts on page load
        // Copy to clipboard function
        function copyToClipboard(text, button) {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(text).then(() => {
                    const originalHTML = button.innerHTML;
                    button.innerHTML = "<i class=\"fas fa-check\"></i> Copied!";
                    button.style.background = "rgba(16, 185, 129, 0.3)";
                    setTimeout(() => {
                        button.innerHTML = originalHTML;
                        button.style.background = "rgba(255,255,255,0.2)";
                    }, 2000);
                });
            } else {
                // Fallback for older browsers
                const textArea = document.createElement("textarea");
                textArea.value = text;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand("copy");
                document.body.removeChild(textArea);
                
                const originalHTML = button.innerHTML;
                button.innerHTML = "<i class=\"fas fa-check\"></i> Copied!";
                button.style.background = "rgba(16, 185, 129, 0.3)";
                setTimeout(() => {
                    button.innerHTML = originalHTML;
                    button.style.background = "rgba(255,255,255,0.2)";
                }, 2000);
            }
        }
        

        window.addEventListener('load', function() {
            const forceUpdateTexts = () => {
                // All text mappings
                const textMap = {
                    // Stats
                    'donationGoalStatus': 'Donation Goal Progress',
                    'progressPercentage': '(68% achieved)',
                    'monthlyServerCost': 'Monthly Server Cost',
                    'numberOfDonors': 'Number of Donors',
                    'newFeatures': 'New Features Developed',
                    
                    // Donation options
                    'coffeeCup': 'A Cup of Coffee',
                    'coffeeDesc': 'Buy a warm cup of coffee for the developer',
                    'coffeeAndCake': 'Coffee and Cake',
                    'cakeDesc': 'Add sweet support to development',
                    'pizzaMeal': 'Pizza Meal',
                    'pizzaDesc': 'A hearty meal for late-night developers!',
                    'researchBooks': 'Research Books',
                    'booksDesc': 'Support learning for better features',
                    'serverDonation': 'Server Support',
                    'serverDesc': 'Support for stable service operation',
                    'customAmount': 'Custom Amount',
                    'yourChoice': 'Your Choice',
                    'customDesc': 'Donate any amount you wish',
                    
                    // WIA Coin benefits
                    'wiaCoinBenefits': 'WIA Coin Donor Special Benefits',
                    'vipBadge': 'Priority Support',
                    'vipBadgeDesc': 'Dedicated support channel for WIA Coin donors',
                    'earlyAccess': 'Early Access',
                    'earlyAccessDesc': 'Priority access to beta features',
                    'directCommunication': 'Direct Communication',
                    'directCommunicationDesc': 'Direct channel with Dr. Samheum Yeon',
                    'valueGrowth': 'Value Growth',
                    'valueGrowthDesc': 'Coin value grows with platform'
                };
                
                // Update all elements
                Object.keys(textMap).forEach(key => {
                    document.querySelectorAll(`[data-translate="${key}"]`).forEach(el => {
                        if (el.textContent === key || el.textContent.trim() === '') {
                            el.textContent = textMap[key];
                        }
                    });
                });
            };
            
            // Run immediately and after delays
            forceUpdateTexts();
            setTimeout(forceUpdateTexts, 100);
            setTimeout(forceUpdateTexts, 500);
            
            // Fix remaining texts
            const additionalTexts = {
                'selectDonation': 'Select Donation Option',
                'wiaCoinValue': 'WIA Coin = Investment in Future Value',
                'wiaCoinDesc': 'Support the platform with our native token used by researchers worldwide!',
                'exclusiveDigitalBadge': 'Digital Badge for All Donors',
                'badgeUsage': 'Every donor receives a personalized digital badge. Use it proudly!',
                'vipBadge': 'Priority Support',
                'vipBadgeDesc': 'Dedicated support channel for WIA Coin donors'
            ,
                'selectPayment': 'Select Payment Method',
                'creditCard': 'Credit Card',
                'bankTransfer': 'Bank Transfer',};
            
            Object.keys(additionalTexts).forEach(key => {
                document.querySelectorAll(`[data-translate="${key}"]`).forEach(el => {
                    el.textContent = additionalTexts[key];
                });
            });
        });
    </script>


    <script>
        // Comprehensive text fix for all elements
        const fixAllTexts = () => {
            const allTexts = {
                // Headers
                'selectDonation': 'Select Donation Option',
                'selectPayment': 'Select Payment Method',
                
                // Payment methods
                'creditCard': 'Credit Card',
                'bankTransfer': 'Bank Transfer',
                
                // Crypto
                'copyAddress': 'Copy Address',
                'qrCode': 'QR Code',
                'donateWithBitcoin': 'Donate with Bitcoin',
                'donateWithEthereum': 'Donate with Bitcoin',
                'donateWithUSDT': 'Donate with USDT (TRC-20)',
                'donateWithWIA': 'Donate with WIA Coin',
                
                // Stats
                'donationGoalStatus': 'Donation Goal Progress',
                'monthlyServerCost': 'Monthly Server Cost',
                'numberOfDonors': 'Number of Donors',
                'newFeatures': 'New Features Developed',
                
                // WIA Coin
                'wiaCoinValue': 'WIA Coin = Investment in Future Value',
                'wiaCoinDesc': 'Support the platform with our native token used by researchers worldwide!',
                
                // Form
                'donorInformation': 'Donor Information',
                'nameRequired': 'Name *',
                'emailRequired': 'Email *',
                'affiliationOptional': 'Affiliation (Optional)',
                'donateButton': 'Donate',
                
                // Badge
                'exclusiveDigitalBadge': 'Digital Badge for All Donors',
                'downloadBadge': 'Download Badge (PNG)',
                // Form and footer texts
                'donationAmountCustom': 'Donation Amount (For custom selection)',
                'displayOptionRequired': 'Display Option *',
                'showInHallOfFame': 'Show in Hall of Fame',
                'anonymousDonation': 'Anonymous Donation',
                'backToWIA': 'Back to WIA',
                'donationsUsedFor': 'All donations are used to improve the research environment.',
                // Additional missing texts
                'nameRequired': 'Name *',
                'emailRequired': 'Email *',
                'affiliationOptional': 'Affiliation (Optional)',
                'receiveDigitalBadge': 'Receive digital donor badge',
                'receiveNewsletter': 'Receive WIA newsletter'
            };;
            
            // Fix display option select
            const displaySelect = document.getElementById('display-option');
            if (displaySelect) {
                displaySelect.options[0].text = 'Show in Hall of Fame';
                displaySelect.options[1].text = 'Anonymous Donation';
            }
            
            // Apply all texts
            Object.keys(allTexts).forEach(key => {
                const elements = document.querySelectorAll(`[data-translate="${key}"]`);
                elements.forEach(el => {
                    // Force update regardless of current content
                    el.textContent = allTexts[key];
                });
            });
        };
        
        // Run on various events to ensure texts are fixed
        document.addEventListener('DOMContentLoaded', fixAllTexts);
        window.addEventListener('load', fixAllTexts);
        setTimeout(fixAllTexts, 100);
        setTimeout(fixAllTexts, 500);
        setTimeout(fixAllTexts, 1000);
    </script>

</body>
</html>