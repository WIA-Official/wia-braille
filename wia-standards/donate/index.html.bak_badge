    <!-- JavaScript -->
    <script>
        // Currency conversion data
        const currencies = {
            usd: { symbol: '$', amounts: [5, 10, 25, 50, 100] },
            eur: { symbol: '€', amounts: [5, 10, 25, 50, 100] },
            gbp: { symbol: '£', amounts: [4, 8, 20, 40, 80] },
            jpy: { symbol: '¥', amounts: [750, 1500, 3750, 7500, 15000] },
            krw: { symbol: '₩', amounts: [7000, 14000, 35000, 70000, 140000] },
            cny: { symbol: '¥', amounts: [35, 70, 175, 350, 700] },
            cad: { symbol: 'C$', amounts: [7, 14, 35, 70, 140] },
            aud: { symbol: 'A$', amounts: [8, 16, 40, 80, 160] }
        };

        // Currency selection handler
        document.querySelectorAll('.currency-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                // Change active button
                document.querySelectorAll('.currency-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                
                // Update donation amounts
                const currency = this.dataset.currency;
                updateDonationAmounts(currency);
            });
        });

        // Update donation amounts function
        function updateDonationAmounts(currency) {
            const currencyData = currencies[currency];
            const donationOptions = document.querySelectorAll('.donation-option');
            
            donationOptions.forEach((option, index) => {
                if (index < currencyData.amounts.length) {
                    const amountElement = option.querySelector('.donation-amount');
                    amountElement.textContent = currencyData.symbol + currencyData.amounts[index].toLocaleString();
                    option.dataset.amount = currencyData.amounts[index];
                }
            });
        }

        // Donation option selection handler
        document.querySelectorAll('.donation-option').forEach(option => {
            option.addEventListener('click', function() {
                // Change selection state
                document.querySelectorAll('.donation-option').forEach(o => o.classList.remove('selected'));
                this.classList.add('selected');
                
                // Show/hide custom amount field
                const customAmountField = document.getElementById('donation-amount-custom');
                if (this.dataset.amount === 'custom') {
                    customAmountField.style.display = 'block';
                    customAmountField.focus();
                } else {
                    customAmountField.value = this.dataset.amount;
                    customAmountField.style.display = 'block';
                }
                
                // Scroll to Donor Information
                setTimeout(() => {
                    const donorForm = document.querySelector('.donation-form');
                    if (donorForm) {
                        donorForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                }, 100);
            });
        });

        // Payment method selection handler
        document.querySelectorAll('.payment-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                // Change selection state
                document.querySelectorAll('.payment-btn').forEach(b => b.classList.remove('selected'));
                this.classList.add('selected');
                
                console.log('Payment method selected:', this.dataset.method);
            
            // Bank Transfer sections toggle
            if (this.dataset.method === "bank") {
                const bankSections = document.getElementById("bank-transfer-sections");
                if (bankSections) {
                    bankSections.style.display = bankSections.style.display === "block" ? "none" : "block";
                }
            }
            
            // Crypto section toggle functionality
            if (this.dataset.method === "bitcoin" || this.dataset.method === "usdt" || this.dataset.method === "wiacoin") {
                // Hide all crypto sections first
                document.querySelectorAll(".crypto-info").forEach(section => {
                    section.style.display = "none";
                });
                
                // Show clicked section
                const targetClass = this.dataset.method === "bitcoin" ? "donateWithBitcoin" :
                                  this.dataset.method === "usdt" ? "donateWithUSDT" : "donateWithWIA";
                const targetSection = document.querySelector(`[data-translate="${targetClass}"]`);
                if (targetSection) {
                    const cryptoSection = targetSection.closest(".crypto-info");
                    if (cryptoSection) {
                        cryptoSection.style.display = cryptoSection.style.display === "block" ? "none" : "block";
                    }
                }
            }
            });
        });

        // Donation form submission handler
        document.getElementById('donation-form').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Show loading state
            const submitBtn = this.querySelector('.submit-btn');
            const originalText = submitBtn.innerHTML;
            submitBtn.innerHTML = '<div class="spinner"></div>';
            submitBtn.classList.add('loading');
            submitBtn.disabled = true;
            
            // Collect form data
            const formData = {
                name: document.getElementById('donor-name').value,
                affiliation: document.getElementById('donor-affiliation').value,
                email: document.getElementById('donor-email').value,
                amount: getSelectedAmount(),
                displayOption: document.getElementById('display-option').value,
                badgeDownload: document.getElementById('badge-download').checked,
                newsletter: document.getElementById('newsletter').checked
            };
            
            // Send to server
            fetch('/donate/donate-submit.php', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(formData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Show success message
                    document.getElementById('thank-you-message').classList.add('show');
                    document.getElementById('thank-you-message').scrollIntoView({ behavior: 'smooth' });
                    // Reset form
                    document.getElementById('donation-form').reset();
                } else {
                    alert(data.message || 'An error occurred. Please try again.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Failed to submit. Please try again later.');
            })
            .finally(() => {
                submitBtn.innerHTML = originalText;
                submitBtn.classList.remove('loading');
                submitBtn.disabled = false;
            });
        });

        // Get selected donation amount
        function getSelectedAmount() {
            const selectedOption = document.querySelector('.donation-option.selected');
            if (selectedOption) {
                if (selectedOption.dataset.amount === 'custom') {
                    return document.getElementById('donation-amount-custom').value;
                } else {
                    return selectedOption.dataset.amount;
                }
            }
            return 0;
        }

        // Digital badge download
        // Badge download with Template Image
        document.querySelector('.download-btn').addEventListener('click', async function() {
            const btn = this;
            const originalHTML = btn.innerHTML;
            
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';
            btn.disabled = true;
            
            try {
                const badgeName = document.querySelector('.badge-name').textContent || 'Supporter';
                const badgeYear = document.querySelector('.badge-year').textContent || new Date().getFullYear().toString();
                
                // 금액에 따른 티어 결정
                const amount = parseInt(getSelectedAmount()) || 5;
                let tier = 'supporter';
                if (amount >= 500) tier = 'diamond';
                else if (amount >= 100) tier = 'gold';
                else if (amount >= 25) tier = 'silver';
                else if (amount >= 5) tier = 'bronze';
                
                // 템플릿 이미지 로드
                const img = new Image();
                img.crossOrigin = 'anonymous';
                img.src = '/donate/badges/wia-' + tier + '.png';
                
                img.onload = function() {
                    // Canvas 생성
                    const canvas = document.createElement('canvas');
                    canvas.width = 1024;
                    canvas.height = 1024;
                    const ctx = canvas.getContext('2d');
                    
                    // 템플릿 이미지 그리기
                    ctx.drawImage(img, 0, 0, 1024, 1024);
                    
                    // 연도 텍스트 (중앙 하단)
                    ctx.fillStyle = '#5c3d00';
                    ctx.font = 'bold 72px Georgia, serif';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillText(badgeYear, 512, 680);
                    
                    // 이름 텍스트 (하단 리본)
                    ctx.fillStyle = '#5c3d00';
                    ctx.font = 'bold 52px Georgia, serif';
                    ctx.fillText(badgeName, 512, 880);
                    
                    // 다운로드
                    const link = document.createElement('a');
                    const tierName = tier.charAt(0).toUpperCase() + tier.slice(1);
                    link.download = 'WIA-' + tierName + '-Supporter-' + badgeName.replace(/[^a-zA-Z0-9가-힣]/g, '') + '-' + badgeYear + '.png';
                    link.href = canvas.toDataURL('image/png');
                    link.click();
                    
                    btn.innerHTML = '<i class="fas fa-check"></i> Downloaded!';
                    setTimeout(() => {
                        btn.innerHTML = originalHTML;
                        btn.disabled = false;
                    }, 2000);
                };
                
                img.onerror = function() {
                    throw new Error('Failed to load badge template');
                };
                
            } catch (error) {
                console.error('Badge generation error:', error);
                alert('Failed to generate badge. Please try again.');
                btn.innerHTML = originalHTML;
                btn.disabled = false;
            }
        });

        // Language change handler
        const langSelector = document.getElementById('language-selector'); if (langSelector) langSelector.addEventListener('change', function() {
            const selectedLang = this.value;
            console.log('Language changed:', selectedLang);
            // Add language change logic here
        });

        // WIA Coin related functionality
        document.querySelectorAll('.crypto-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const contractAddress = '0xF92Bb9587e596831214DbdE4498e901861BCD282';
                
                if (this.textContent.includes('Copy')) {
                    navigator.clipboard.writeText(contractAddress).then(() => {
                        this.innerHTML = '<i class="fas fa-check"></i> Copied!';
                        setTimeout(() => {
                            this.innerHTML = '<i class="fas fa-copy"></i> Copy Address';
                        }, 2000);
                    });
                } else if (this.textContent.includes('QR')) {
                    alert('QR code generation feature coming soon! 📱');
                } else if (this.textContent.includes('Blockchair')) {
                    window.open(`https://etherscan.io/token/${contractAddress}`, '_blank');
                }
            });
        });

        // Payment method selection with WIA Coin special handling
        document.querySelectorAll('.payment-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                // Remove previous selection
                document.querySelectorAll('.payment-btn').forEach(b => b.classList.remove('selected'));
                this.classList.add('selected');
                
                if (this.dataset.method === 'wiacoin') {
                    // Special notification for WIA Coin selection
                    alert('🌟 Donate with WIA Coin for special benefits!\n\n✅ VIP Badge\n✅ Early Access to Features\n✅ Direct Developer Communication\n✅ Coin Value Growth Benefits');
                }
                
                console.log('Payment method selected:', this.dataset.method);
            
            // Bank Transfer sections toggle
            if (this.dataset.method === "bank") {
                const bankSections = document.getElementById("bank-transfer-sections");
                if (bankSections) {
                    bankSections.style.display = bankSections.style.display === "block" ? "none" : "block";
                }
            }
            
            // Crypto section toggle functionality
            if (this.dataset.method === "bitcoin" || this.dataset.method === "usdt" || this.dataset.method === "wiacoin") {
                // Hide all crypto sections first
                document.querySelectorAll(".crypto-info").forEach(section => {
                    section.style.display = "none";
                });
                
                // Show clicked section
                const targetClass = this.dataset.method === "bitcoin" ? "donateWithBitcoin" :
                                  this.dataset.method === "usdt" ? "donateWithUSDT" : "donateWithWIA";
                const targetSection = document.querySelector(`[data-translate="${targetClass}"]`);
                if (targetSection) {
                    const cryptoSection = targetSection.closest(".crypto-info");
                    if (cryptoSection) {
                        cryptoSection.style.display = cryptoSection.style.display === "block" ? "none" : "block";
                    }
                }
            }
            });
        });

        // Page load animations
        // Copy to clipboard function
        function copyToClipboard(text, button) {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(text).then(() => {
                    const originalHTML = button.innerHTML;
                    button.innerHTML = "<i class=\"fas fa-check\"></i> Copied!";
                    button.style.background = "rgba(16, 185, 129, 0.3)";
                    setTimeout(() => {
                        button.innerHTML = originalHTML;
                        button.style.background = "rgba(255,255,255,0.2)";
                    }, 2000);
                });
            } else {
                // Fallback for older browsers
                const textArea = document.createElement("textarea");
                textArea.value = text;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand("copy");
                document.body.removeChild(textArea);
                
                const originalHTML = button.innerHTML;
                button.innerHTML = "<i class=\"fas fa-check\"></i> Copied!";
                button.style.background = "rgba(16, 185, 129, 0.3)";
                setTimeout(() => {
                    button.innerHTML = originalHTML;
                    button.style.background = "rgba(255,255,255,0.2)";
                }, 2000);
            }
        }
        

        window.addEventListener('load', function() {
            const elements = document.querySelectorAll('.animate-fade-in');
            elements.forEach((el, index) => {
                setTimeout(() => {
                    el.style.opacity = '1';
                    el.style.transform = 'translateY(0)';
                }, index * 200);
            });
        });

        // Initial animation setup
        document.querySelectorAll('.animate-fade-in').forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(30px)';
            el.style.transition = 'all 0.6s ease-out';
        });
    </script>
    
    <!-- Language System Scripts -->
    <script>
    // Restore saved language state on page load
    document.addEventListener("DOMContentLoaded", function() {
        const savedLanguage = localStorage.getItem("wiasis_language") || "en";
        const selector = document.getElementById("language-selector");
        if (selector) {
            selector.value = savedLanguage;
            // Save state when language changes
            selector.addEventListener("change", function() {
                localStorage.setItem("wiasis_language", this.value);
            });
        }
    });
    </script>

