                </div>
            </section>


            <!-- Thank You Message -->
            <section class="thank-you-message" id="thank-you-message">
                <h2>🙏 <span data-translate="thankYou">Thank You!</span></h2>
                <p><span data-translate="thankYouMessage1">Your precious donation will be a great help to researchers worldwide.</span></p>
                <p><span data-translate="thankYouMessage2">We have sent your digital badge to your email.</span></p>
            </section>

        </div>
    </main>

