    <footer>
        <p class="philosophy">弘益人間 · Benefit All Humanity</p>
        <p>WIA - World Certification Industry Association</p>
        <p>© 2025 MIT License</p>
        <div class="footer-links">
            <a href="https://wiastandards.com" target="_blank">🏠 Home</a>
            <a href="https://wiastandards.com/#standards" target="_blank" data-en="📋 All Standards" data-ko="📋 전체 표준">📋 All Standards</a>
            <a href="https://wiabooks.store" target="_blank" data-en="📚 Ebook" data-ko="📚 전자책">📚 Ebook</a>
            <a href="https://github.com/WIA-Official/WIHP" target="_blank">GitHub</a>
        </div>
    </footer>

    <script>
        const params = new URLSearchParams(window.location.search);
        const file = params.get('file');
        
        if (file) {
            document.getElementById('browser').style.display = 'none';
            document.getElementById('viewer').style.display = 'block';
            document.querySelector('footer').style.display = 'none';
            
            fetch(file)
                .then(response => {
                    if (!response.ok) throw new Error('File not found');
                    return response.text();
                })
                .then(markdown => {
                    document.getElementById('viewer').innerHTML = marked.parse(markdown);
                })
                .catch(error => {
                    document.getElementById('viewer').innerHTML = `
                        <div style="text-align: center; padding: 60px;">
                            <p style="color: #ef4444; font-size: 1.2rem;">❌ ${error.message}</p>
                            <p style="color: #94a3b8; margin-top: 10px;">File: ${file}</p>
                            <a href="/wihp/viewer.html" style="display: inline-block; margin-top: 20px; padding: 10px 20px; background: #10b981; color: white; border-radius: 6px; text-decoration: none;">← Back to Browser</a>
                        </div>
                    `;
                });
        }
        // Language toggle
        function setLang(lang) {
            localStorage.setItem("wiaLang", lang);
            document.querySelectorAll(".lang-btn").forEach(btn => btn.classList.remove("active"));
            event.target.classList.add("active");
            document.querySelectorAll("[data-en][data-ko]").forEach(el => {
                el.textContent = el.getAttribute("data-" + lang);
            });
        }
        // Init language on load
        document.addEventListener("DOMContentLoaded", function() {
            const savedLang = localStorage.getItem("wiaLang") || "en";
            if (savedLang === "ko") {
                document.querySelectorAll(".lang-btn").forEach(btn => btn.classList.remove("active"));
                document.querySelector(".lang-btn:last-child").classList.add("active");
                document.querySelectorAll("[data-en][data-ko]").forEach(el => el.textContent = el.getAttribute("data-ko"));
            }
        });
    </script>
</body>
</html>
