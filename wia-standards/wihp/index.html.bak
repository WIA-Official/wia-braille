<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WIA WIHP - International Hangul Phonology</title>
    <link rel="icon" href="/favicon.ico">
    <style>
        :root {
            --primary: #10B981;
            --primary-dark: #059669;
            --bg: #0f172a;
            --bg-card: #1e293b;
            --text: #f8fafc;
            --text-muted: #94a3b8;
            --border: #334155;
            --gold: #ffd700;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            line-height: 1.6;
        }
        .nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 30px;
            background: rgba(15, 23, 42, 0.95);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .nav-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--text); }
        .nav-brand:hover { opacity: 0.9; }
        .nav-logo { font-size: 1.5rem; }
        .nav-title { font-weight: 700; }
        .breadcrumb { color: var(--text-muted); font-size: 0.9rem; }
        .breadcrumb a { color: var(--primary); text-decoration: none; }
        .lang-toggle {
            display: flex;
            gap: 5px;
            background: var(--bg-card);
            padding: 5px;
            border-radius: 8px;
        }
        .lang-btn {
            padding: 5px 12px;
            border: none;
            background: transparent;
            color: var(--text-muted);
            cursor: pointer;
            border-radius: 5px;
            font-size: 0.85rem;
        }
        .lang-btn.active {
            background: var(--primary);
            color: white;
        }
        .hero {
            text-align: center;
            padding: 60px 20px;
            background: linear-gradient(180deg, var(--bg) 0%, rgba(16, 185, 129, 0.1) 100%);
        }
        .hero-emoji {
            font-size: 80px;
            margin-bottom: 20px;
            animation: pulse 2s ease-in-out infinite;
        }
        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.15); }
        }
        .hero h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            background: linear-gradient(135deg, var(--primary), #34d399);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero-subtitle {
            font-size: 1.3rem;
            color: var(--text-muted);
            margin-bottom: 15px;
        }
        .hero-philosophy {
            color: var(--gold);
            font-size: 1.1rem;
            margin-bottom: 20px;
        }
        .hero-desc {
            max-width: 700px;
            margin: 0 auto 30px;
            color: var(--text-muted);
            font-size: 1.05rem;
        }
        .hero-example {
            background: var(--bg-card);
            border-radius: 12px;
            padding: 25px;
            max-width: 500px;
            margin: 0 auto 30px;
            border: 1px solid var(--border);
        }
        .example-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid var(--border);
        }
        .example-row:last-child { border-bottom: none; }
        .example-label { color: var(--text-muted); font-size: 0.9rem; }
        .example-value { font-size: 1.3rem; font-weight: 600; }
        .example-value.ipa { font-family: monospace; color: #f59e0b; }
        .example-value.wihp { color: var(--primary); font-size: 1.5rem; }
        .example-arrow { color: var(--primary); font-size: 1.5rem; }
        .action-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 30px;
        }
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 25px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s;
        }
        .btn-primary {
            background: var(--primary);
            color: white;
        }
        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }
        .btn-secondary {
            background: var(--bg-card);
            color: var(--text);
            border: 1px solid var(--border);
        }
        .btn-secondary:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
        }
        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
        .section { padding: 60px 0; }
        .section-title {
            text-align: center;
            font-size: 1.8rem;
            margin-bottom: 40px;
        }
        /* 2x2 그리드 */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
            max-width: 900px;
            margin: 0 auto;
        }
        @media (max-width: 768px) {
            .features-grid { grid-template-columns: 1fr; }
        }
        .feature-card {
            background: var(--bg-card);
            border-radius: 12px;
            padding: 25px;
            border: 1px solid var(--border);
            transition: all 0.3s;
        }
        .feature-card:hover {
            border-color: var(--primary);
            transform: translateY(-3px);
        }
        .feature-icon { font-size: 2.5rem; margin-bottom: 15px; }
        .feature-title { font-size: 1.2rem; margin-bottom: 10px; color: var(--text); }
        .feature-desc { color: var(--text-muted); font-size: 0.95rem; }
        .tiers-section { background: rgba(16, 185, 129, 0.05); }
        /* 2x2 + 1 그리드 */
        .tier-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            max-width: 900px;
            margin: 0 auto;
        }
        @media (max-width: 768px) {
            .tier-grid { grid-template-columns: 1fr; }
        }
        .tier-card {
            background: var(--bg-card);
            border-radius: 12px;
            padding: 20px;
            border: 1px solid var(--border);
        }
        .tier-card.special {
            grid-column: 1 / -1;
            text-align: center;
        }
        .tier-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }
        .tier-title { font-weight: 600; color: var(--primary); }
        .tier-count {
            background: var(--primary);
            color: white;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
        }
        .tier-languages {
            color: var(--text-muted);
            font-size: 0.9rem;
            line-height: 1.8;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 40px;
        }
        @media (max-width: 768px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
        }
        .stat-card {
            background: var(--bg-card);
            border-radius: 12px;
            padding: 25px;
            text-align: center;
            border: 1px solid var(--border);
        }
        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--primary);
        }
        .stat-label { color: var(--text-muted); margin-top: 5px; }
        .ecosystem-section { text-align: center; }
        .ecosystem-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            max-width: 800px;
            margin: 0 auto;
        }
        .eco-card {
            background: var(--bg-card);
            border-radius: 12px;
            padding: 25px;
            border: 1px solid var(--border);
            text-decoration: none;
            color: var(--text);
            transition: all 0.3s;
        }
        .eco-card:hover {
            border-color: var(--primary);
            transform: translateY(-3px);
        }
        .eco-icon { font-size: 2.5rem; margin-bottom: 10px; }
        .eco-title { font-weight: 600; margin-bottom: 5px; }
        .eco-desc { color: var(--text-muted); font-size: 0.85rem; }
        footer {
            text-align: center;
            padding: 40px 20px;
            border-top: 1px solid var(--border);
            color: var(--text-muted);
        }
        footer .philosophy {
            color: var(--gold);
            font-size: 1.1rem;
            margin-bottom: 10px;
        }
        .badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        .badge-complete { background: #059669; color: white; }
        .links-section {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
            margin-top: 30px;
        }
        .links-section a {
            color: var(--primary);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .links-section a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <nav class="nav">
        <a href="/" class="nav-brand">
            <span class="nav-logo">🤟</span>
            <span class="nav-title">WIA</span>
        </a>
        <div class="breadcrumb">
            <a href="/">Home</a> / <span data-en="WIHP" data-ko="WIHP">WIHP</span>
        </div>
        <div class="lang-toggle">
            <button class="lang-btn active" onclick="setLang('en')">EN</button>
            <button class="lang-btn" onclick="setLang('ko')">KO</button>
        </div>
    </nav>

    <section class="hero">
        <div class="hero-emoji">🇰🇷</div>
        <h1>WIA WIHP</h1>
        <p class="hero-subtitle" data-en="WIA International Hangul Phonology" data-ko="WIA 국제 한글 음성학">WIA International Hangul Phonology</p>
        <p class="hero-philosophy">弘益人間 (홍익인간) · Benefit All Humanity</p>
        <p class="hero-desc" data-en="Read 7,000+ world languages in Hangul. The evolution of IPA after 137 years - everyone can read, everyone can learn." data-ko="전 세계 7,000+ 언어를 한글로 읽습니다. 137년 만에 IPA의 진화 - 누구나 읽고, 누구나 배웁니다.">Read 7,000+ world languages in Hangul. The evolution of IPA after 137 years - everyone can read, everyone can learn.</p>
        
        <div class="hero-example">
            <div class="example-row">
                <span class="example-label" data-en="Traditional IPA" data-ko="기존 IPA">Traditional IPA</span>
                <span class="example-value ipa">/həˈloʊ/</span>
            </div>
            <div class="example-row" style="justify-content: center;">
                <span class="example-arrow">↓</span>
            </div>
            <div class="example-row">
                <span class="example-label" data-en="WIHP (Hangul)" data-ko="WIHP (한글)">WIHP (Hangul)</span>
                <span class="example-value wihp">헐로우</span>
            </div>
            <div class="example-row" style="border-top: 1px solid var(--border); margin-top: 10px; padding-top: 15px;">
                <span class="example-label" data-en="Who can read?" data-ko="누가 읽을 수 있나요?">Who can read?</span>
                <span class="example-value" style="font-size: 1rem; color: var(--primary);" data-en="Everyone! 👨‍👩‍👧‍👦" data-ko="모두! 👨‍👩‍👧‍👦">Everyone! 👨‍👩‍👧‍👦</span>
            </div>
        </div>

        <span class="badge badge-complete" data-en="✅ Phase 1 Complete - 122 Languages" data-ko="✅ Phase 1 완료 - 122개 언어">✅ Phase 1 Complete - 122 Languages</span>

        <div class="action-buttons">
            <a href="viewer.html" class="btn btn-primary" data-en="📖 View WIHP Specs" data-ko="📖 WIHP 스펙 보기">📖 View WIHP Specs</a>
            <a href="https://github.com/WIA-Official/WIHP" target="_blank" class="btn btn-secondary">🐙 GitHub</a>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number">122</div>
                    <div class="stat-label" data-en="Languages Mapped" data-ko="매핑된 언어">Languages Mapped</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">7,000+</div>
                    <div class="stat-label" data-en="Target Languages" data-ko="목표 언어">Target Languages</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">137</div>
                    <div class="stat-label" data-en="Years Since IPA" data-ko="IPA 이후 년수">Years Since IPA</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">24</div>
                    <div class="stat-label" data-en="Hangul Consonants" data-ko="한글 자음">Hangul Consonants</div>
                </div>
            </div>
        </div>
    </section>

    <section class="section features-section">
        <div class="container">
            <h2 class="section-title" data-en="🎯 Why WIHP?" data-ko="🎯 왜 WIHP인가?">🎯 Why WIHP?</h2>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">📚</div>
                    <h3 class="feature-title" data-en="IPA is Academic" data-ko="IPA는 학술용">IPA is Academic</h3>
                    <p class="feature-desc" data-en="Only linguists can read /həˈloʊ/. WIHP makes it accessible: 헐로우" data-ko="언어학자만 /həˈloʊ/를 읽을 수 있습니다. WIHP는 이를 쉽게: 헐로우">Only linguists can read /həˈloʊ/. WIHP makes it accessible: 헐로우</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🌍</div>
                    <h3 class="feature-title" data-en="7,000+ Languages" data-ko="7,000+ 언어">7,000+ Languages</h3>
                    <p class="feature-desc" data-en="Each language has different scripts. WIHP unifies them all with Hangul." data-ko="각 언어마다 다른 문자 체계. WIHP는 한글로 모두 통합합니다.">Each language has different scripts. WIHP unifies them all with Hangul.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">⏳</div>
                    <h3 class="feature-title" data-en="Preserve Languages" data-ko="언어 보존">Preserve Languages</h3>
                    <p class="feature-desc" data-en="50% of languages may disappear in 100 years. WIHP preserves pronunciation in Hangul." data-ko="100년 후 50%의 언어가 소멸될 수 있습니다. WIHP는 발음을 한글로 보존합니다.">50% of languages may disappear in 100 years. WIHP preserves pronunciation in Hangul.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">👶</div>
                    <h3 class="feature-title" data-en="Learn Once, Read All" data-ko="한 번 배우면 다 읽는다">Learn Once, Read All</h3>
                    <p class="feature-desc" data-en="Learn Hangul once, read any language's pronunciation. Universal accessibility." data-ko="한글을 한 번 배우면 어떤 언어의 발음이든 읽을 수 있습니다. 범용 접근성.">Learn Hangul once, read any language's pronunciation. Universal accessibility.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="section tiers-section">
        <div class="container">
            <h2 class="section-title" data-en="📊 Language Tiers" data-ko="📊 언어 티어">📊 Language Tiers</h2>
            <div class="tier-grid">
                <div class="tier-card">
                    <div class="tier-header">
                        <span class="tier-title">Tier 1 - Major</span>
                        <span class="tier-count">20</span>
                    </div>
                    <p class="tier-languages">English, Korean, Japanese, Mandarin, Spanish, French, German, Russian, Arabic, Hindi, Portuguese, Italian, Dutch, Polish, Vietnamese, Thai, Indonesian, Turkish, Greek, Bengali</p>
                </div>
                <div class="tier-card">
                    <div class="tier-header">
                        <span class="tier-title">Tier 2 - Regional</span>
                        <span class="tier-count">25</span>
                    </div>
                    <p class="tier-languages">Tamil, Telugu, Swahili, Persian, Ukrainian, Hebrew, Czech, Romanian, Hungarian, Malay, Tagalog, Punjabi, Gujarati, Kannada, Malayalam, Marathi, Burmese, Khmer, Lao, Nepali...</p>
                </div>
                <div class="tier-card">
                    <div class="tier-header">
                        <span class="tier-title">Tier 3 - Extended</span>
                        <span class="tier-count">30</span>
                    </div>
                    <p class="tier-languages">Georgian, Hawaiian, Basque, Icelandic, Mongolian, Tibetan, Amharic, Yoruba, Zulu, Hausa, Igbo, Somali, Maori, Samoan, Tongan, Fijian, Welsh, Irish, Scottish Gaelic...</p>
                </div>
                <div class="tier-card">
                    <div class="tier-header">
                        <span class="tier-title">Tier 4 - Specialized</span>
                        <span class="tier-count">40</span>
                    </div>
                    <p class="tier-languages">Finnish, Swedish, Danish, Norwegian, Croatian, Serbian, Slovak, Slovenian, Estonian, Latvian, Lithuanian, Esperanto, Interlingua, Toki Pona, Klingon, Elvish, Dothraki...</p>
                </div>
                <div class="tier-card special">
                    <div class="tier-header" style="justify-content: center; gap: 15px;">
                        <span class="tier-title">✨ Special</span>
                        <span class="tier-count">7</span>
                    </div>
                    <p class="tier-languages">ASL (American Sign), KSL (Korean Sign), JSL (Japanese Sign), Braille, Latin, Sanskrit, Classical Arabic</p>
                </div>
            </div>
        </div>
    </section>

    <section class="section ecosystem-section">
        <div class="container">
            <h2 class="section-title" data-en="🔗 WIA Ecosystem" data-ko="🔗 WIA 생태계">🔗 WIA Ecosystem</h2>
            <div class="ecosystem-grid">
                <a href="/isp/" class="eco-card">
                    <div class="eco-icon">🤟</div>
                    <div class="eco-title">ISP</div>
                    <div class="eco-desc" data-en="Sign Language → Notation" data-ko="수어 → 표기법">Sign Language → Notation</div>
                </a>
                <a href="https://wiabraille.com" target="_blank" class="eco-card">
                    <div class="eco-icon">⠿</div>
                    <div class="eco-title">WIA Braille</div>
                    <div class="eco-desc" data-en="IPA → Braille" data-ko="IPA → 점자">IPA → Braille</div>
                </a>
                <div class="eco-card" style="border-color: var(--primary); background: rgba(16, 185, 129, 0.1);">
                    <div class="eco-icon">🇰🇷</div>
                    <div class="eco-title">WIHP</div>
                    <div class="eco-desc" data-en="IPA → Hangul (You are here!)" data-ko="IPA → 한글 (현재 위치!)">IPA → Hangul (You are here!)</div>
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container" style="text-align: center;">
            <h2 class="section-title" data-en="📖 Explore WIHP" data-ko="📖 WIHP 탐색">📖 Explore WIHP</h2>
            <div class="action-buttons">
                <a href="viewer.html" class="btn btn-primary" data-en="📖 WIHP Spec Viewer" data-ko="📖 WIHP 스펙 뷰어">📖 WIHP Spec Viewer</a>
                <a href="viewer.html?file=wihp/core/WIHP-MAP-CONSONANTS.md" class="btn btn-secondary" data-en="자음 Consonants" data-ko="자음 Consonants">자음 Consonants</a>
                <a href="viewer.html?file=wihp/core/WIHP-MAP-VOWELS.md" class="btn btn-secondary" data-en="모음 Vowels" data-ko="모음 Vowels">모음 Vowels</a>
            </div>
            <div class="links-section">
                <a href="https://github.com/WIA-Official/WIHP" target="_blank">🐙 GitHub Repository</a>
                <a href="https://cert.wiastandards.com" target="_blank">🏅 Get Certified</a>
            </div>
        </div>
    </section>

    <footer>
        <p class="philosophy">弘益人間 (홍익인간) · Benefit All Humanity</p>
        <p>© 2025 WIA Standards · MIT License</p>
        <p style="margin-top: 10px; font-size: 0.85rem;">
            <span data-en="Sejong the Great created Hangul for Koreans. WIA created WIHP for all humanity." data-ko="세종대왕은 한국인을 위해 한글을 만들었습니다. WIA는 전 인류를 위해 WIHP를 만들었습니다.">Sejong the Great created Hangul for Koreans. WIA created WIHP for all humanity.</span>
        </p>
    </footer>

    <script>
        function setLang(lang) {
            localStorage.setItem('wiaLang', lang);
            document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelector(`.lang-btn:${lang === 'en' ? 'first-child' : 'last-child'}`).classList.add('active');
            document.querySelectorAll('[data-en]').forEach(el => {
                el.textContent = el.getAttribute(`data-${lang}`);
            });
        }
        const savedLang = localStorage.getItem('wiaLang') || 'en';
        setLang(savedLang);
    </script>
</body>
</html>
